# The House v2 — environment configuration example.
# Copy to .env for local development. NEVER commit real secrets.
# Production deployments must supply these via a secret manager (e.g. Azure Key Vault),
# not a committed .env file.

# --- Core application ---
DATABASE_URL=
APP_ENV=local
APP_REGION=canada
LOG_LEVEL=info

# --- Azure Service Bus (outbox publishing target; not connected in scaffold) ---
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_OUTBOX_TOPIC=
AZURE_SERVICE_BUS_OUTBOX_QUEUE=

# --- Transactional outbox processor tuning ---
OUTBOX_BATCH_SIZE=25
OUTBOX_LOCK_SECONDS=120
OUTBOX_BASE_DELAY_MS=1000
OUTBOX_MAX_DELAY_MS=300000
OUTBOX_MAX_RETRIES=10
