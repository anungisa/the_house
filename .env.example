# The House v2 — environment configuration example.
# Copy to .env for local development. NEVER commit real secrets.
# Production deployments must supply these via a secret manager (e.g. Azure Key Vault),
# not a committed .env file.

# --- Core application ---
DATABASE_URL=
APP_ENV=local
APP_REGION=canada
LOG_LEVEL=info

# --- Azure Service Bus (outbox publishing target) ---
# Disabled by default: the outbox publisher is a no-op and NO connection string is required.
# Local/test runtimes never need Service Bus. Set SERVICE_BUS_ENABLED=true only to publish
# against a real broker. NEVER commit a real connection string (use a secret manager).
# When enabled: connection string is required; for queue target QUEUE_NAME is required, for
# topic target TOPIC_NAME is required. v1 does NOT use Service Bus sessions.
SERVICE_BUS_ENABLED=false
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=
SERVICE_BUS_TOPIC_NAME=
SERVICE_BUS_PUBLISH_TARGET=queue

# --- Transactional outbox processor tuning ---
OUTBOX_BATCH_SIZE=25
OUTBOX_LOCK_SECONDS=120
OUTBOX_BASE_DELAY_MS=1000
OUTBOX_MAX_DELAY_MS=300000
OUTBOX_MAX_RETRIES=10

# --- Local/demo HTTP API runtime (npm run dev:api) ---
# LOCAL/DEMO ONLY: this runtime ships no edge auth. Do not expose it publicly.
# DATABASE_URL (above) is REQUIRED to start the runtime.
API_HOST=127.0.0.1
API_PORT=3000

# --- Demo seed identifiers (npm run demo:seed:affiliation) ---
# NSO-generic demo IDs; override as needed. Not secrets.
DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
DEMO_APPLICATION_ID=22222222-2222-2222-2222-222222222222
DEMO_SEASON_ID=2026
DEMO_ACTOR_USER_ID=33333333-3333-3333-3333-333333333333
# Optional: elevated/separate connection for seeding (falls back to DATABASE_URL).
DEMO_DATABASE_URL=
