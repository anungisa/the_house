# The House v2 — environment configuration example.
# Copy to .env for local development. NEVER commit real secrets.
# Production deployments must supply these via a secret manager (e.g. Azure Key Vault),
# not a committed .env file.

# --- Platform / runtime ---
# NODE_ENV controls non-secret runtime behavior (e.g. error-stack inclusion in logs).
# Use "development" locally; deployments set "production". This is NOT the same as APP_ENV.
NODE_ENV=development

# --- Core application ---
# DATABASE_URL: app connection string. In real deployments point this at the NON-superuser,
# RLS-respecting application role; supply it via a secret manager (Key Vault), never committed.
DATABASE_URL=
# MIGRATE_DATABASE_URL: privileged migration connection used ONLY to run db/migrations
# (separate from the app role). Falls back to DATABASE_URL locally; supply via secret manager
# in deployments. Migrations run as a SEPARATE step, never on app startup.
MIGRATE_DATABASE_URL=
APP_ENV=local
APP_REGION=canada
LOG_LEVEL=info

# --- Azure Service Bus (outbox publishing target) ---
# Disabled by default: the outbox publisher is a no-op and NO connection string is required.
# Local/test runtimes never need Service Bus. Set SERVICE_BUS_ENABLED=true only to publish
# against a real broker. NEVER commit a real connection string (use a secret manager).
# When enabled: connection string is required; for queue target QUEUE_NAME is required, for
# topic target TOPIC_NAME is required. v1 does NOT use Service Bus sessions.
SERVICE_BUS_ENABLED=false
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=
SERVICE_BUS_TOPIC_NAME=
SERVICE_BUS_PUBLISH_TARGET=queue

# --- Transactional outbox processor tuning ---
OUTBOX_BATCH_SIZE=25
OUTBOX_LOCK_SECONDS=120
OUTBOX_BASE_DELAY_MS=1000
OUTBOX_MAX_DELAY_MS=300000
OUTBOX_MAX_RETRIES=10

# --- Outbox worker runtime host (npm run worker:outbox) ---
# Schedules OutboxWorker.processBatch() to drain the outbox. Requires DATABASE_URL
# (point it at the dedicated SECURITY DEFINER worker role in real deployments).
# RUN_ONCE=true processes a single batch then exits (useful for cron/smoke).
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=5000
OUTBOX_WORKER_BATCH_SIZE=25
OUTBOX_WORKER_ID=local-outbox-worker
OUTBOX_WORKER_LOCK_SECONDS=60
OUTBOX_WORKER_RUN_ONCE=false

# --- Local/demo HTTP API runtime (npm run dev:api) ---
# LOCAL/DEMO ONLY: this runtime ships no edge auth. Do not expose it publicly.
# DATABASE_URL (above) is REQUIRED to start the runtime.
API_HOST=127.0.0.1
API_PORT=3000

# --- Edge identity / auth mode (HTTP boundary) ---
# Selects how the HTTP adapter establishes the TRUSTED tenant + actor for a request.
#   demo            LOCAL/DEMO ONLY. tenant/actor are read from the request BODY (the caller
#                   is trusted to declare who they are). Never use outside local/demo.
#   trusted_headers tenant/actor are derived from trusted x-house-* request headers injected
#                   by a verifying edge (reverse proxy / API gateway / identity provider).
#                   Body-supplied identity is rejected. This is NOT token/JWT validation: it
#                   assumes a trusted upstream that authenticates the user and OVERWRITES the
#                   x-house-* headers. Only safe behind such a trusted edge; the x-house-*
#                   headers must NEVER be accepted directly from arbitrary clients.
#   entra_jwt       tenant/actor are derived from a validated `Authorization: Bearer <JWT>`
#                   token (Microsoft Entra / OIDC). The token is the identity boundary: the
#                   signature, issuer, audience, and expiry are verified against the JWKS, and
#                   x-house-* headers and body identity are IGNORED. Use this when the API is
#                   exposed directly to token-bearing clients (no trusted header-injecting
#                   edge). Requires the ENTRA_* settings below.
# Trusted headers (v1): x-house-tenant-id (required), x-house-actor-user-id (required),
#   x-house-actor-role-keys, x-house-actor-permission-keys (comma-separated),
#   x-house-scope-type, x-house-scope-id, x-house-organization-id, x-house-organization-unit-id.
# An unknown value fails closed at startup.
AUTH_MODE=demo

# --- Microsoft Entra / OIDC JWT validation (only when AUTH_MODE=entra_jwt) ---
# Required when AUTH_MODE=entra_jwt; ignored otherwise. Tokens are validated against the JWKS
# (signing-key rotation handled automatically; no secrets are logged). NONE of these are
# secrets — the bearer token itself is never read from config and never logged.
#   ENTRA_ISSUER     expected `iss` (required URL), e.g. https://login.microsoftonline.com/<tenant>/v2.0
#   ENTRA_AUDIENCE   expected `aud` (required), e.g. api://house-v2 or the app/client id
#   ENTRA_JWKS_URI   JWKS endpoint (required URL), e.g.
#                    https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
#   ENTRA_TENANT_ID  informational tenant id (optional; not used for validation)
# Claim NAMES are configurable (NSO-generic; no sport-specific claims). Defaults match Entra:
#   ENTRA_USER_ID_CLAIM      identity/user id claim (default: oid)
#   ENTRA_TENANT_ID_CLAIM    tenant id claim (default: tid)
#   ENTRA_ROLE_CLAIM         roles claim, array (default: roles)
#   ENTRA_PERMISSION_CLAIM   permissions/scopes claim, space- or comma-delimited (default: scp)
#   ENTRA_ORGANIZATION_ID_CLAIM       optional organization id claim (unset = not mapped)
#   ENTRA_ORGANIZATION_UNIT_ID_CLAIM  optional organization unit id claim (unset = not mapped)
ENTRA_ISSUER=
ENTRA_AUDIENCE=
ENTRA_JWKS_URI=
ENTRA_TENANT_ID=
ENTRA_USER_ID_CLAIM=oid
ENTRA_TENANT_ID_CLAIM=tid
ENTRA_ROLE_CLAIM=roles
ENTRA_PERMISSION_CLAIM=scp
ENTRA_ORGANIZATION_ID_CLAIM=
ENTRA_ORGANIZATION_UNIT_ID_CLAIM=

# --- Evidence payload/document storage ---
# Stores the BYTES of evidence documents behind the governance evidence model. This is the
# PAYLOAD layer only: governance evidence METADATA always lives in PostgreSQL
# (governance.evidence_object) and is created solely by the Governance Kernel. Storing a
# payload is NOT a lifecycle approval and never bypasses governance metadata.
#   memory      LOCAL/DEMO/TEST default. In-process store; requires no Azure config.
#   azure_blob  Real Azure Blob Storage. Requires a connection string AND a container name.
# Payloads are hash-addressed (SHA-256) under tenants/{tenantId}/evidence/{evidenceObjectId}/{sha256}.
# EVIDENCE_STORAGE_REQUIRE_HASH verifies the digest on read (recommended: true).
# EVIDENCE_UPLOAD_MAX_BYTES caps the HTTP upload endpoint body size (must be a positive
# integer; default 10485760 = 10 MiB). Applies to both providers; no Azure config required.
# NEVER commit a real connection string (use a secret manager). v1 uses connection-string auth.
EVIDENCE_STORAGE_PROVIDER=memory
EVIDENCE_BLOB_CONNECTION_STRING=
EVIDENCE_BLOB_CONTAINER_NAME=
EVIDENCE_STORAGE_REQUIRE_HASH=true
EVIDENCE_UPLOAD_MAX_BYTES=10485760

# --- Evidence malware scanning (ingestion gate) ---
# Inspects uploaded payload BYTES BEFORE they are stored. This is an ingestion check, NOT a
# governed lifecycle decision: it never approves/rejects a transition or mutates governed
# state. An infected payload is rejected (422) and never stored.
#   EVIDENCE_MALWARE_SCANNING_MODE:
#     disabled   No scanning; the no-op scanner returns "skipped". Default (local/demo).
#     signature  Deterministic, in-process signature matcher. No external AV engine, process,
#                or network call.
#   EVIDENCE_MALWARE_SCANNING_REQUIRED:
#     false  Best-effort: only a positive "infected" result rejects the upload (default).
#     true   Fail closed: a "skipped"/"error" scan also rejects (503). Requires a real scanner
#            mode (disabled+required=true fails closed at config load).
#   EVIDENCE_MALWARE_TEST_SIGNATURES_ENABLED:
#     Loads the harmless EICAR test signature so the pipeline can be exercised without real
#     malware. LOCAL/DEMO/TEST ONLY; default false.
EVIDENCE_MALWARE_SCANNING_MODE=disabled
EVIDENCE_MALWARE_SCANNING_REQUIRED=false
EVIDENCE_MALWARE_TEST_SIGNATURES_ENABLED=false

# --- Evidence quarantine workflow ---
# When a malware scan BLOCKS an upload (infected, or error/skipped when scanning is required),
# the platform records a sanitized security event and emits an "evidence.quarantine.recorded"
# outbox event. The infected BYTES are NEVER stored in normal evidence storage. Quarantine is
# operational security metadata, NOT lifecycle governance: it never approves/rejects a
# transition, mutates governed state, or executes a workflow.
#   EVIDENCE_QUARANTINE_ENABLED:
#     true   Record blocked uploads + emit the outbox event (default).
#     false  Blocked uploads are still rejected, just not recorded.
#   EVIDENCE_QUARANTINE_INCLUDE_EVENT_ID_IN_RESPONSE:
#     true   Include the (non-sensitive) quarantineEventId in the rejection response (default).
#            Threat details are never surfaced regardless.
EVIDENCE_QUARANTINE_ENABLED=true
EVIDENCE_QUARANTINE_INCLUDE_EVENT_ID_IN_RESPONSE=true

# --- Observability / metrics ---
# Vendor-neutral operational telemetry: counters, durations, and sanitized events across the
# HTTP, authorization, workflow, evidence/quarantine, and outbox runtime paths. This is
# VISIBILITY only — it never writes governed tables, never affects authz/workflow/quarantine
# decisions, never leaks secrets/tokens/raw bytes, and contacts NO external system by default.
# Attributes are passed through the shared secret redactor before export.
#   OBSERVABILITY_ENABLED:
#     true   Emit telemetry through the configured exporter (default).
#     false  Wire a no-op telemetry (allocation-free); no signals are emitted.
#   OBSERVABILITY_EXPORTER (fails closed on any other value):
#     console  Write sanitized single-line JSON records to stdout (default for runtime).
#     memory   Retain signals in process memory (primarily tests/diagnostics).
#     noop     Discard all signals.
#   OBSERVABILITY_INCLUDE_DEBUG_ATTRIBUTES:
#     false  Default. Reserved for future verbose attribute expansion.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_EXPORTER=console
OBSERVABILITY_INCLUDE_DEBUG_ATTRIBUTES=false

# --- Demo seed identifiers (npm run demo:seed:affiliation) ---
# NSO-generic demo IDs; override as needed. Not secrets.
DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
DEMO_APPLICATION_ID=22222222-2222-2222-2222-222222222222
DEMO_SEASON_ID=2026
DEMO_ACTOR_USER_ID=33333333-3333-3333-3333-333333333333
# Optional: elevated/separate connection for seeding (falls back to DATABASE_URL).
DEMO_DATABASE_URL=
