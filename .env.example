# The House v2 — environment configuration example.
# Copy to .env for local development. NEVER commit real secrets.
# Production deployments must supply these via a secret manager (e.g. Azure Key Vault),
# not a committed .env file.

# --- Core application ---
DATABASE_URL=
APP_ENV=local
APP_REGION=canada
LOG_LEVEL=info

# --- Azure Service Bus (outbox publishing target) ---
# Disabled by default: the outbox publisher is a no-op and NO connection string is required.
# Local/test runtimes never need Service Bus. Set SERVICE_BUS_ENABLED=true only to publish
# against a real broker. NEVER commit a real connection string (use a secret manager).
# When enabled: connection string is required; for queue target QUEUE_NAME is required, for
# topic target TOPIC_NAME is required. v1 does NOT use Service Bus sessions.
SERVICE_BUS_ENABLED=false
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=
SERVICE_BUS_TOPIC_NAME=
SERVICE_BUS_PUBLISH_TARGET=queue

# --- Transactional outbox processor tuning ---
OUTBOX_BATCH_SIZE=25
OUTBOX_LOCK_SECONDS=120
OUTBOX_BASE_DELAY_MS=1000
OUTBOX_MAX_DELAY_MS=300000
OUTBOX_MAX_RETRIES=10

# --- Outbox worker runtime host (npm run worker:outbox) ---
# Schedules OutboxWorker.processBatch() to drain the outbox. Requires DATABASE_URL
# (point it at the dedicated SECURITY DEFINER worker role in real deployments).
# RUN_ONCE=true processes a single batch then exits (useful for cron/smoke).
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=5000
OUTBOX_WORKER_BATCH_SIZE=25
OUTBOX_WORKER_ID=local-outbox-worker
OUTBOX_WORKER_LOCK_SECONDS=60
OUTBOX_WORKER_RUN_ONCE=false

# --- Local/demo HTTP API runtime (npm run dev:api) ---
# LOCAL/DEMO ONLY: this runtime ships no edge auth. Do not expose it publicly.
# DATABASE_URL (above) is REQUIRED to start the runtime.
API_HOST=127.0.0.1
API_PORT=3000

# --- Edge identity / auth mode (HTTP boundary) ---
# Selects how the HTTP adapter establishes the TRUSTED tenant + actor for a request.
#   demo            LOCAL/DEMO ONLY. tenant/actor are read from the request BODY (the caller
#                   is trusted to declare who they are). Never use outside local/demo.
#   trusted_headers tenant/actor are derived from trusted x-house-* request headers injected
#                   by a verifying edge (reverse proxy / API gateway / identity provider).
#                   Body-supplied identity is rejected. This is NOT token/JWT validation: it
#                   assumes a trusted upstream that authenticates the user and OVERWRITES the
#                   x-house-* headers. Only safe behind such a trusted edge; the x-house-*
#                   headers must NEVER be accepted directly from arbitrary clients.
# Trusted headers (v1): x-house-tenant-id (required), x-house-actor-user-id (required),
#   x-house-actor-role-keys, x-house-actor-permission-keys (comma-separated),
#   x-house-scope-type, x-house-scope-id, x-house-organization-id, x-house-organization-unit-id.
# An unknown value fails closed at startup.
AUTH_MODE=demo

# --- Evidence payload/document storage ---
# Stores the BYTES of evidence documents behind the governance evidence model. This is the
# PAYLOAD layer only: governance evidence METADATA always lives in PostgreSQL
# (governance.evidence_object) and is created solely by the Governance Kernel. Storing a
# payload is NOT a lifecycle approval and never bypasses governance metadata.
#   memory      LOCAL/DEMO/TEST default. In-process store; requires no Azure config.
#   azure_blob  Real Azure Blob Storage. Requires a connection string AND a container name.
# Payloads are hash-addressed (SHA-256) under tenants/{tenantId}/evidence/{evidenceObjectId}/{sha256}.
# EVIDENCE_STORAGE_REQUIRE_HASH verifies the digest on read (recommended: true).
# NEVER commit a real connection string (use a secret manager). v1 uses connection-string auth.
EVIDENCE_STORAGE_PROVIDER=memory
EVIDENCE_BLOB_CONNECTION_STRING=
EVIDENCE_BLOB_CONTAINER_NAME=
EVIDENCE_STORAGE_REQUIRE_HASH=true

# --- Demo seed identifiers (npm run demo:seed:affiliation) ---
# NSO-generic demo IDs; override as needed. Not secrets.
DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
DEMO_APPLICATION_ID=22222222-2222-2222-2222-222222222222
DEMO_SEASON_ID=2026
DEMO_ACTOR_USER_ID=33333333-3333-3333-3333-333333333333
# Optional: elevated/separate connection for seeding (falls back to DATABASE_URL).
DEMO_DATABASE_URL=
