{
  "name": "house-v2",
  "version": "0.0.0",
  "private": true,
  "description": "The House v2 — governed backend platform core for Canadian National Sport Organization operations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/db-seed.ts",
    "dev:api": "tsx scripts/api-dev.ts",
    "demo:seed:affiliation": "tsx scripts/demo-seed-affiliation.ts",
    "worker:outbox": "tsx scripts/outbox-worker.ts",
    "config:check": "tsx scripts/config-check.ts",
    "deploy:check": "tsx scripts/validate-deployment-baseline.ts",
    "container:check": "tsx scripts/validate-container-baseline.ts",
    "migrations:check": "tsx scripts/validate-migrations.ts",
    "migrations:plan": "tsx scripts/migrate-db.ts --plan",
    "migrations:apply": "tsx scripts/migrate-db.ts --apply",
    "supply-chain:check": "tsx scripts/validate-supply-chain-baseline.ts",
    "sbom:generate": "tsx scripts/generate-sbom.ts",
    "image:scan": "tsx scripts/scan-image.ts",
    "provenance:check": "tsx scripts/validate-provenance-baseline.ts",
    "image:sign": "tsx scripts/sign-image.ts",
    "sbom:attest": "tsx scripts/attest-sbom.ts",
    "smoke:check": "tsx scripts/validate-azure-smoke-baseline.ts",
    "smoke:azure": "tsx scripts/azure-smoke-test.ts",
    "release:check": "tsx scripts/validate-release-runbook-baseline.ts",
    "ci:check": "npm run typecheck && npm run lint && npm test && npm run build && npm run deploy:check && npm run container:check && npm run migrations:check && npm run supply-chain:check && npm run provenance:check && npm run smoke:check && npm run release:check"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.33.0",
    "dotenv": "^16.4.5",
    "jose": "^6.2.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
