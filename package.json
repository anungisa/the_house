{
  "name": "house-v2",
  "version": "0.0.0",
  "private": true,
  "description": "The House v2 — governed backend platform core for Canadian National Sport Organization operations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "coverage:report": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/db-seed.ts",
    "dev:api": "tsx scripts/api-dev.ts",
    "demo:seed:affiliation": "tsx scripts/demo-seed-affiliation.ts",
    "worker:outbox": "tsx scripts/outbox-worker.ts",
    "config:check": "tsx scripts/config-check.ts",
    "deploy:check": "tsx scripts/validate-deployment-baseline.ts",
    "container:check": "tsx scripts/validate-container-baseline.ts",
    "migrations:check": "tsx scripts/validate-migrations.ts",
    "migrations:plan": "tsx scripts/migrate-db.ts --plan",
    "migrations:apply": "tsx scripts/migrate-db.ts --apply",
    "supply-chain:check": "tsx scripts/validate-supply-chain-baseline.ts",
    "sbom:generate": "tsx scripts/generate-sbom.ts",
    "image:scan": "tsx scripts/scan-image.ts",
    "provenance:check": "tsx scripts/validate-provenance-baseline.ts",
    "image:sign": "tsx scripts/sign-image.ts",
    "sbom:attest": "tsx scripts/attest-sbom.ts",
    "smoke:check": "tsx scripts/validate-azure-smoke-baseline.ts",
    "smoke:azure": "tsx scripts/azure-smoke-test.ts",
    "release:check": "tsx scripts/validate-release-runbook-baseline.ts",
    "synthetic:check": "tsx scripts/validate-synthetic-lifecycle-baseline.ts",
    "organization:check": "tsx scripts/validate-organization-registry-baseline.ts",
    "participant:check": "tsx scripts/validate-participant-registry-baseline.ts",
    "facility:check": "tsx scripts/validate-facility-registry-baseline.ts",
    "governance:check": "node docs/program/volume-0/controls/governance-check.mjs",
    "governance:report": "node docs/program/volume-0/controls/generate-control-report.mjs",
    "governance:docs": "node docs/program/volume-0/controls/build-executive-formats.mjs",
    "governance:check:v1": "node docs/program/volume-1/controls/governance-check.mjs",
    "governance:report:v1": "node docs/program/volume-1/controls/generate-control-report.mjs",
    "governance:check:v2": "node docs/program/volume-2/controls/governance-check.mjs",
    "governance:report:v2": "node docs/program/volume-2/controls/generate-control-report.mjs",
    "governance:trace:v2": "node docs/program/volume-2/controls/trace-volume-2.mjs",
    "governance:check:v3": "node docs/program/volume-3/controls/governance-check.mjs",
    "governance:report:v3": "node docs/program/volume-3/controls/generate-control-report.mjs",
    "governance:trace:v3": "node docs/program/volume-3/controls/trace-volume-3.mjs",
    "governance:closure:v3": "node docs/program/volume-3/controls/closure-volume-3.mjs",
    "governance:check:v4": "node docs/program/volume-4/controls/governance-check.mjs",
    "governance:report:v4": "node docs/program/volume-4/controls/generate-control-report.mjs",
    "governance:trace:v4": "node docs/program/volume-4/controls/trace-volume-4.mjs",
    "governance:closure:v4": "node docs/program/volume-4/controls/closure-volume-4.mjs",
    "governance:check:v5": "node docs/program/volume-5/controls/governance-check.mjs",
    "governance:report:v5": "node docs/program/volume-5/controls/generate-control-report.mjs",
    "governance:trace:v5": "node docs/program/volume-5/controls/trace-volume-5.mjs",
    "governance:closure:v5": "node docs/program/volume-5/controls/closure-volume-5.mjs",
    "governance:logical:v5": "node docs/program/volume-5/controls/logical-model-analysis.mjs",
    "governance:lifecycle:v5": "node docs/program/volume-5/controls/data-lifecycle-analysis.mjs",
    "governance:physical:v5": "node docs/program/volume-5/controls/physical-model-analysis.mjs",
    "governance:check:v6": "node docs/program/volume-6/controls/governance-check.mjs",
    "governance:report:v6": "node docs/program/volume-6/controls/generate-control-report.mjs",
    "governance:trace:v6": "node docs/program/volume-6/controls/trace-volume-6.mjs",
    "governance:foundation:v6": "node docs/program/volume-6/controls/foundation-volume-6.mjs",
    "governance:controlmodel:v6": "node docs/program/volume-6/controls/control-model-volume-6.mjs",
    "governance:complianceaccessibility:v6": "node docs/program/volume-6/controls/compliance-accessibility-volume-6.mjs",
    "governance:incidentresilienceassurance:v6": "node docs/program/volume-6/controls/incident-resilience-assurance-volume-6.mjs",
    "governance:closure:v6": "node docs/program/volume-6/controls/closure-volume-6.mjs",
    "governance:finalclosure:v6": "node docs/program/volume-6/controls/final-closure-volume-6.mjs",
    "governance:releaseassurance:v6": "node docs/program/volume-6/controls/release-assurance-volume-6.mjs",
    "governance:check:v7": "node docs/program/volume-7/controls/governance-check.mjs",
    "governance:report:v7": "node docs/program/volume-7/controls/generate-control-report.mjs",
    "governance:foundation:v7": "node docs/program/volume-7/controls/foundation-volume-7.mjs",
    "governance:gate:v7": "node docs/program/volume-7/controls/gate-volume-7.mjs",
    "governance:interaction:v7": "node docs/program/volume-7/controls/interaction-model-volume-7.mjs",
    "governance:gate2:v7": "node docs/program/volume-7/controls/gate-volume-7-g2.mjs",
    "governance:design:v7": "node docs/program/volume-7/controls/design-system-volume-7.mjs",
    "governance:gate3:v7": "node docs/program/volume-7/controls/gate-volume-7-g3.mjs",
    "governance:provenance:v7": "node docs/program/volume-7/controls/provenance-integrity-volume-7.mjs",
    "governance:validation:v7": "node docs/program/volume-7/controls/validation-handoff-volume-7.mjs",
    "governance:gate4:v7": "node docs/program/volume-7/controls/gate-volume-7-g4.mjs",
    "governance:finalclosure:v7": "node docs/program/volume-7/controls/final-closure-volume-7.mjs",
    "governance:gate5:v7": "node docs/program/volume-7/controls/gate-volume-7-g5.mjs",
    "qualification:base44": "node docs/program/volume-1/controls/inventory-base44.mjs",
    "qualification:house": "node docs/program/volume-1/controls/inventory-house.mjs",
    "qualification:ecosystem": "node docs/program/volume-1/controls/inventory-ecosystem.mjs",
    "qualification:convergence": "node docs/program/volume-1/controls/inventory-convergence.mjs",
    "ci:check": "npm run typecheck && npm run lint && npm test && npm run build && npm run deploy:check && npm run container:check && npm run migrations:check && npm run supply-chain:check && npm run provenance:check && npm run smoke:check && npm run release:check && npm run synthetic:check && npm run organization:check && npm run participant:check && npm run facility:check"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.33.0",
    "dotenv": "^16.4.5",
    "jose": "^6.2.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.20.0",
    "eslint": "^9.17.0",
    "html-to-docx": "1.8.0",
    "js-yaml": "^4.3.0",
    "marked": "18.0.7",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
