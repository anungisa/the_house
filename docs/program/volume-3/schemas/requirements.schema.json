{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "requirements.schema.json",
  "title": "REG-303 Volume 3 Requirement and Acceptance Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-303" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "statement", "product", "traces_to", "authorizes_implementation"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/requirementId" },
          "level": { "$ref": "common.schema.json#/definitions/requirementLevel" },
          "statement": { "type": "string" },
          "product": { "$ref": "common.schema.json#/definitions/product" },
          "traces_to": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "acceptance_ref": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TEST-V3-[0-9]{3}$" }
          },
          "governed_by_kernel": { "type": "boolean" },
          "authorizes_implementation": { "type": "boolean" },
          "validation_status": {
            "type": "string",
            "enum": ["author_asserted", "stakeholder_validation_pending", "stakeholder_validated"]
          },
          "rule_classification": {
            "type": "string",
            "enum": [
              "DEFINED_PRODUCT_RULE",
              "POLICY_VALIDATION_PENDING",
              "OPERATIONAL_VALIDATION_PENDING",
              "FINANCIAL_VALIDATION_PENDING",
              "PRIVACY_VALIDATION_PENDING",
              "STAKEHOLDER_VALIDATION_PENDING"
            ]
          },
          "policy_owner": { "type": "string" },
          "operational_owner": { "type": "string" },
          "effective_scope": { "type": "string" },
          "season_versioned": { "type": "boolean" },
          "jurisdiction_scoped": { "type": "boolean" },
          "exception_authority": { "type": "string" },
          "future_blocking_gate": { "type": "string" },
          "service_stage": { "type": "string" },
          "primary_persona": { "type": "string" },
          "secondary_personas": {
            "type": "array",
            "items": { "type": "string" }
          },
          "channel_scope": { "type": "string" },
          "user_visible": { "type": "boolean" },
          "content_owner": { "type": "string" },
          "language_status": { "type": "string" },
          "accessibility_status": { "type": "string" },
          "privacy_classification": { "type": "string" },
          "support_dependency": { "type": "string" },
          "acceptance_status": {
            "type": "string",
            "enum": [
              "DEFINED",
              "BASELINE_PENDING",
              "POLICY_VALIDATION_PENDING",
              "OPERATIONAL_VALIDATION_PENDING",
              "ACCESSIBILITY_VALIDATION_PENDING",
              "BILINGUAL_VALIDATION_PENDING",
              "PRIVACY_VALIDATION_PENDING",
              "STAKEHOLDER_VALIDATION_PENDING"
            ]
          },
          "measure_identifier": { "type": "string", "pattern": "^MEAS-V3-[0-9]{2}$" },
          "measure_baseline_status": {
            "type": "string",
            "enum": [
              "DEFINED",
              "BASELINE_PENDING",
              "POLICY_VALIDATION_PENDING",
              "FINANCIAL_VALIDATION_PENDING",
              "OPERATIONAL_VALIDATION_PENDING",
              "ACCESSIBILITY_VALIDATION_PENDING",
              "BILINGUAL_VALIDATION_PENDING",
              "PRIVACY_VALIDATION_PENDING",
              "STAKEHOLDER_VALIDATION_PENDING",
              "PRODUCTION_PROOF_PENDING"
            ]
          },
          "measure_target_status": { "type": "string" },
          "validation_authority": { "type": "string" },
          "change_classification": {
            "type": "string",
            "enum": [
              "EDITORIAL",
              "NON_MATERIAL_PRODUCT",
              "MATERIAL_PRODUCT",
              "POLICY",
              "FINANCIAL",
              "PRIVACY",
              "ACCESSIBILITY",
              "BILINGUAL",
              "AUTHORITY_BOUNDARY",
              "BREAKING_SERVICE_CHANGE"
            ]
          },
          "gap_disposition": {
            "type": "string",
            "enum": [
              "CLOSED",
              "ACCEPTED_AS_FUTURE_VOLUME_INPUT",
              "VALIDATION_PENDING",
              "POLICY_PENDING",
              "INTENTIONALLY_EXCLUDED",
              "DEFECT_REQUIRING_AMENDMENT"
            ]
          },
          "operating_phase": { "type": "string" },
          "operating_function": { "type": "string" },
          "accountable_function": { "type": "string" },
          "performing_function": { "type": "string" },
          "handoff_from": { "type": "string" },
          "handoff_to": { "type": "string" },
          "decision_authority": { "type": "string" },
          "exception_class": {
            "type": "string",
            "enum": [
              "APPLICANT_REMEDIATION",
              "OPERATIONAL_EXCEPTION",
              "POLICY_EXCEPTION",
              "ADMINISTRATIVE_CORRECTION",
              "DECISION_RECONSIDERATION",
              "DATA_QUALITY_CORRECTION",
              "INCIDENT_RECOVERY"
            ]
          },
          "control_frequency": {
            "type": "string",
            "enum": [
              "EVENT_DRIVEN",
              "CONTINUOUS",
              "PER_CASE",
              "PER_SEASON",
              "PERIODIC_BASELINE_PENDING",
              "INCIDENT_DRIVEN"
            ]
          },
          "evidence_generated": { "type": "string" },
          "capacity_dependency": { "type": "string" },
          "governance_domain": { "type": "string" },
          "governance_forum": { "type": "string" },
          "decision_class": { "type": "string" },
          "decision_owner": { "type": "string" },
          "consulted_functions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risk_category": { "type": "string" },
          "control_owner": { "type": "string" },
          "control_performer": { "type": "string" },
          "assurance_method": { "type": "string" },
          "reporting_purpose": { "type": "string" },
          "dependency_owner": { "type": "string" },
          "record_steward": { "type": "string" },
          "continuity_priority": { "type": "string" },
          "change_class": {
            "type": "string",
            "enum": [
              "EDITORIAL",
              "NON_MATERIAL_OPERATING",
              "MATERIAL_OPERATING",
              "POLICY",
              "FINANCIAL",
              "PRIVACY",
              "BILINGUAL",
              "ACCESSIBILITY",
              "AUTHORITY_BOUNDARY",
              "EMERGENCY",
              "BREAKING_OPERATING_CHANGE"
            ]
          },
          "incident_class": {
            "type": "string",
            "enum": [
              "USER_SUPPORT_ISSUE",
              "OPERATIONAL_EXCEPTION",
              "SERVICE_INCIDENT",
              "PRIVACY_INCIDENT",
              "FINANCIAL_RECONCILIATION_INCIDENT",
              "EXTERNAL_PROVIDER_INCIDENT",
              "CONTROL_FAILURE",
              "RECURRING_PROBLEM",
              "CONTINUITY_EVENT",
              "MATERIAL_ORGANIZATIONAL_INCIDENT"
            ]
          },
          "service_function": { "type": "string" },
          "service_delivery_class": {
            "type": "string",
            "enum": [
              "NATIONALLY_CENTRALIZED",
              "JURISDICTIONALLY_DISTRIBUTED",
              "CLUB_PERFORMED",
              "SHARED_SERVICE",
              "EXTERNAL_EXECUTION",
              "MANUAL_TRANSITIONAL",
              "FUTURE_STATE_UNRESOLVED"
            ]
          },
          "role_archetype": { "type": "string" },
          "competency_requirement": { "type": "string" },
          "workload_driver": { "type": "string" },
          "capacity_unit": { "type": "string" },
          "peak_demand_factor": { "type": "string" },
          "sourcing_class": {
            "type": "string",
            "enum": [
              "INTERNAL_NATIONAL",
              "INTERNAL_JURISDICTIONAL",
              "SHARED_SERVICE",
              "CLUB_PERFORMED",
              "EXTERNAL_PROVIDER",
              "TRANSITIONAL_MANUAL",
              "SOURCING_DECISION_PENDING"
            ]
          },
          "retained_authority": { "type": "string" },
          "cost_driver": { "type": "string" },
          "cost_classification": {
            "type": "string",
            "enum": [
              "FIXED",
              "VARIABLE_PER_CLUB",
              "VARIABLE_PER_CASE",
              "VARIABLE_PER_TRANSACTION",
              "SEASONAL",
              "TRANSITIONAL",
              "EXTERNAL_CONTRACT",
              "RISK_CONTINGENT",
              "UNKNOWN_PENDING_EVIDENCE"
            ]
          },
          "funding_hypothesis": { "type": "string" },
          "training_audience": { "type": "string" },
          "training_owner": { "type": "string" },
          "readiness_dimension": { "type": "string" },
          "readiness_condition": { "type": "string" },
          "pilot_evidence": { "type": "string" },
          "scale_decision_class": {
            "type": "string",
            "enum": [
              "READY_FOR_VALIDATION",
              "VALIDATION_IN_PROGRESS",
              "EVIDENCE_INSUFFICIENT",
              "OPERATING_MODEL_ADJUSTMENT_REQUIRED",
              "POLICY_DECISION_REQUIRED",
              "FINANCIAL_DECISION_REQUIRED",
              "MATERIAL_COMMITMENT_REQUIRED"
            ]
          },
          "material_commitment_input": { "type": "string" }
        }
      }
    }
  }
}
