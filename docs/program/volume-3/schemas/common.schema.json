{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Volume 3 common definitions",
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registerStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentId": {
      "type": "string",
      "pattern": "^V3-([0-9]{2}|[A-Z])(-[A-Z0-9]+)?$"
    },
    "v3GateId": {
      "type": "string",
      "pattern": "^V3-G[0-9]$"
    },
    "decisionClass": {
      "type": "string",
      "pattern": "^D[0-9]$"
    },
    "evidenceLabel": {
      "type": ["string", "null"],
      "enum": [
        "AUTHOR-VERIFIED",
        "SELF-ATTESTED",
        "SELF-ATTESTED / AUTHOR-VERIFIED",
        "DOMAIN-VALIDATED",
        "PEER-REVIEWED",
        "AUTOMATED-EVIDENCE",
        "INDEPENDENTLY-ASSESSED",
        "EXECUTIVE-ACCEPTED",
        "PRODUCTION-PROVEN",
        null
      ]
    },
    "isoDateOrTbd": {
      "type": "string",
      "pattern": "^(TBD|[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?|.+)$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$"
    },
    "product": {
      "type": "string",
      "enum": ["House", "Button", "Both", "Neither"]
    },
    "stakeholderType": {
      "type": "string",
      "enum": [
        "institutional",
        "member_organization",
        "club",
        "participant",
        "official",
        "administrator",
        "executive",
        "external_system",
        "public"
      ]
    },
    "requirementLevel": {
      "type": "string",
      "enum": [
        "CAP",
        "BR",
        "FR",
        "NFR",
        "UC",
        "RULE",
        "WF",
        "UX",
        "DATA",
        "API",
        "EVT",
        "CTRL",
        "TEST"
      ]
    },
    "requirementId": {
      "type": "string",
      "pattern": "^(CAP|BR|FR|NFR|UC|RULE|WF|UX|DATA|API|EVT|CTRL|TEST)-V3-[0-9]{3}$"
    },
    "inheritanceStatus": {
      "type": "string",
      "enum": ["inherited", "extended", "constrained", "deferred"]
    }
  }
}
