{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "actors-journeys.schema.json",
  "title": "REG-701 Actors, Needs, Journeys, and Service Blueprints",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-701" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "statement", "authorizes_implementation", "implementation_status", "validation_status", "chapter_ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^(ACTOR|NEED|JOURNEY|STAGE|BLUEPRINT|SURFACE|VIEW|FLOW|WIRE|SCREEN|BENCH|FORM)-V7-[0-9]{3}$" },
          "kind": { "$ref": "common.schema.json#/definitions/actorKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "authority_posture": { "$ref": "common.schema.json#/definitions/authorityPosture" },
          "authority_domain": { "$ref": "common.schema.json#/definitions/authorityDomain" },
          "primary_goal": { "type": "string" },
          "permitted_actions": { "type": "array", "items": { "type": "string" } },
          "prohibited_actions": { "type": "array", "items": { "type": "string" } },
          "information_needed": { "type": "array", "items": { "type": "string" } },
          "sensitivity": { "$ref": "common.schema.json#/definitions/sensitivityLevel" },
          "accessibility_needs": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/accessibilityDependency" } },
          "language_needs": { "$ref": "common.schema.json#/definitions/languageRequirement" },
          "failure_and_recovery_needs": { "type": "string" },
          "journey_ref": { "type": "string" },
          "stage_order": { "type": "integer" },
          "house_authority": { "type": "string" },
          "button_responsibility": { "type": "string" },
          "required_information": { "type": "array", "items": { "type": "string" } },
          "decisions": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "states": { "type": "array", "items": { "type": "string" } },
          "errors": { "type": "array", "items": { "type": "string" } },
          "recovery": { "type": "string" },
          "accessibility": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/accessibilityDependency" } },
          "bilingual_semantics": { "$ref": "common.schema.json#/definitions/languageRequirement" },
          "privacy_constraints": { "$ref": "common.schema.json#/definitions/privacyPosture" },
          "future_verification": { "type": "string" },
          "frontstage": { "type": "array", "items": { "type": "string" } },
          "backstage": { "type": "array", "items": { "type": "string" } },
          "staff_activities": { "type": "array", "items": { "type": "string" } },
          "finance_activities": { "type": "array", "items": { "type": "string" } },
          "support_activities": { "type": "array", "items": { "type": "string" } },
          "provider_interactions": { "type": "array", "items": { "type": "string" } },
          "records_responsibility": { "type": "string" },
          "notifications": { "type": "array", "items": { "type": "string" } },
          "failure_recovery_handoff": { "type": "string" },
          "separation_invariants": { "type": "array", "items": { "type": "string" } },
          "purpose": { "type": "string" },
          "authoritative_source": { "$ref": "common.schema.json#/definitions/authorityDomain" },
          "required_inputs": { "type": "array", "items": { "type": "string" } },
          "displayed_information": { "type": "array", "items": { "type": "string" } },
          "command_or_query_intent": { "type": "array", "items": { "type": "string" } },
          "entry_conditions": { "type": "array", "items": { "type": "string" } },
          "exit_conditions": { "type": "array", "items": { "type": "string" } },
          "screen_states": { "type": "array", "items": { "type": "string" } },
          "error_states": { "type": "array", "items": { "type": "string" } },
          "privacy_posture": { "$ref": "common.schema.json#/definitions/privacyPosture" },
          "authority_constraints": { "type": "array", "items": { "type": "string" } },
          "supported_tasks": { "type": "array", "items": { "type": "string" } },
          "surface_ref": { "type": "string" },
          "primary_actor": { "type": "string" },
          "staleness_posture": { "$ref": "common.schema.json#/definitions/stalenessPosture" },
          "fidelity": { "type": "string", "enum": ["LOW_FIDELITY_NON_FINAL", "DOCUMENTARY"] },
          "authorizes_implementation": { "const": false },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "future_blocking_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "chapter_ref": { "type": "string" },
          "traces_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
