{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Volume 4 common definitions",
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registerStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentId": {
      "type": "string",
      "pattern": "^V4-([0-9]{2}|[A-Z])(-[A-Z0-9]+)?$"
    },
    "v4GateId": {
      "type": "string",
      "pattern": "^V4-G[0-9]$"
    },
    "decisionClass": {
      "type": "string",
      "pattern": "^D[0-9]$"
    },
    "evidenceLabel": {
      "type": ["string", "null"],
      "enum": [
        "AUTHOR-VERIFIED",
        "SELF-ATTESTED",
        "SELF-ATTESTED / AUTHOR-VERIFIED",
        "DOMAIN-VALIDATED",
        "PEER-REVIEWED",
        "AUTOMATED-EVIDENCE",
        "INDEPENDENTLY-ASSESSED",
        "EXECUTIVE-ACCEPTED",
        "PRODUCTION-PROVEN",
        null
      ]
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$"
    },
    "authorityDomain": {
      "type": "string",
      "enum": ["House", "Button", "External", "Staff", "Shared", "Neither"]
    },
    "architectureKind": {
      "type": "string",
      "enum": ["ARCH", "MOD", "SVC", "DATA", "API", "EVT", "CTRL", "NFR", "DEP"]
    },
    "architectureStatus": {
      "type": "string",
      "enum": [
        "TARGET_DEFINED",
        "TARGET_CONSTRAINED",
        "TARGET_ASSUMED",
        "TARGET_DEFERRED"
      ]
    },
    "qualityAttribute": {
      "type": "string",
      "enum": [
        "SECURITY",
        "PRIVACY",
        "AVAILABILITY",
        "RESILIENCE",
        "RECOVERABILITY",
        "PERFORMANCE",
        "SCALABILITY",
        "AUDITABILITY",
        "ACCESSIBILITY",
        "BILINGUAL_EQUIVALENCE",
        "OPERABILITY",
        "MAINTAINABILITY",
        "PORTABILITY",
        "INTEROPERABILITY"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "SPECIFIED",
        "FITNESS_FUNCTION_DEFINED",
        "VALIDATION_PENDING",
        "IMPLEMENTATION_PENDING"
      ]
    }
  }
}
