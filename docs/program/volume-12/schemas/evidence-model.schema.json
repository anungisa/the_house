{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence-model.schema.json",
  "title": "REG-1202 Evidence Requirements, Evidence Objects, Findings, Conditions, Waivers, Commitments, and Dossiers",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-1202" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "statement",
          "validation_status",
          "authorizes_implementation",
          "authorizes_operations",
          "authorizes_release",
          "implementation_status",
          "operational_status",
          "execution_status",
          "evidence_status",
          "acceptance_status",
          "release_status",
          "chapter_ref",
          "future_gate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(EVIDREQ|EVID|FINDING|CONDITION|WAIVER|COMMIT|DOSSIER)-V12-[0-9]{3}$" },
          "kind": { "$ref": "common.schema.json#/definitions/evidenceModelKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "scope": { "type": "string" },
          "excluded_scope": { "type": "string" },
          "domain": { "type": "string" },

          "evidence_class": { "$ref": "common.schema.json#/definitions/evidenceClass" },
          "required_evidence_classes": { "type": "string" },
          "minimum_provenance": { "type": "string" },
          "environment_requirement": { "type": "string" },
          "configuration_requirement": { "type": "string" },
          "data_requirement": { "type": "string" },
          "independence_requirement": { "type": "string" },
          "acceptance_authority": { "type": "string" },
          "known_evidentiary_limitations": { "type": "string" },
          "prohibited_substitution": { "type": "string" },
          "prohibited_inference": { "type": "string" },
          "expiry_or_revalidation_dependency": { "type": "string" },
          "final_dossier_destination": { "type": "string" },

          "evidence_binds_requirement": { "type": "string" },
          "evidence_binds_procedure": { "type": "string" },
          "evidence_binds_system": { "type": "string" },
          "evidence_binds_component": { "type": "string" },
          "evidence_binds_version": { "type": "string" },
          "evidence_binds_commit": { "type": "string" },
          "evidence_binds_configuration": { "type": "string" },
          "evidence_binds_environment": { "type": "string" },
          "evidence_binds_identity": { "type": "string" },
          "evidence_binds_organization": { "type": "string" },
          "evidence_binds_jurisdiction": { "type": "string" },
          "evidence_binds_data": { "type": "string" },
          "evidence_binds_provider_state": { "type": "string" },
          "evidence_binds_time": { "type": "string" },
          "integrity_mechanism": { "type": "string" },
          "reproducibility": { "type": "string" },
          "retention_dependency": { "type": "string" },
          "expiry_or_revalidation_date": { "type": "string" },
          "executor": { "type": "string" },
          "reviewer": { "type": "string" },
          "independence_level": { "$ref": "common.schema.json#/definitions/independenceLevel" },
          "acceptance_disposition": { "type": "string" },

          "affected_requirement": { "type": "string" },
          "affected_invariant": { "type": "string" },
          "affected_release_gate": { "type": "string" },
          "authority_impact": { "type": "string" },
          "security_privacy_impact": { "type": "string" },
          "accessibility_bilingual_impact": { "type": "string" },
          "financial_impact": { "type": "string" },
          "migration_impact": { "type": "string" },
          "operational_impact": { "type": "string" },
          "severity_method_dependency": { "type": "string" },
          "owner": { "type": "string" },
          "required_remediation": { "type": "string" },
          "required_evidence": { "type": "string" },
          "retest_or_reexercise_requirement": { "type": "string" },
          "compensating_control_dependency": { "type": "string" },
          "approving_authority": { "type": "string" },
          "effective_period": { "type": "string" },
          "expiry": { "type": "string" },
          "revalidation_condition": { "type": "string" },
          "release_effect": { "type": "string" },

          "dossier_kind": { "type": "string" },
          "contained_sections": { "type": "string" },
          "authoritative_source": { "type": "string" },
          "projection_boundary": { "type": "string" },

          "required_capabilities": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "traces_to": { "type": "array", "items": { "type": "string" } },
          "deliverables": { "type": "array", "items": { "type": "string" } },

          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "evidence_label": { "$ref": "common.schema.json#/definitions/evidenceLabel" },
          "authorizes_implementation": { "type": "boolean", "const": false },
          "authorizes_operations": { "type": "boolean", "const": false },
          "authorizes_release": { "type": "boolean", "const": false },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "operational_status": { "$ref": "common.schema.json#/definitions/operationalStatus" },
          "execution_status": { "$ref": "common.schema.json#/definitions/executionStatus" },
          "evidence_status": { "$ref": "common.schema.json#/definitions/evidenceStatus" },
          "acceptance_status": { "$ref": "common.schema.json#/definitions/acceptanceStatus" },
          "release_status": { "$ref": "common.schema.json#/definitions/releaseStatus" },
          "chapter_ref": { "type": "string" },
          "future_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
