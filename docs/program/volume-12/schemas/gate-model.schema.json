{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate-model.schema.json",
  "title": "REG-1201 Gates, Criteria, Evidence Classes, Acceptance Classes, Authorities, and Release Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-1201" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "statement",
          "validation_status",
          "authorizes_implementation",
          "authorizes_operations",
          "authorizes_release",
          "implementation_status",
          "operational_status",
          "execution_status",
          "evidence_status",
          "acceptance_status",
          "release_status",
          "chapter_ref",
          "future_gate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(GATE|CRITERIA|ECLASS|ACCEPT|AUTH|RELEASE|AEDOM)-V12-[0-9]{3}$" },
          "kind": { "$ref": "common.schema.json#/definitions/gateModelKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "scope": { "type": "string" },
          "excluded_scope": { "type": "string" },

          "evidence_class": { "$ref": "common.schema.json#/definitions/evidenceClass" },
          "authoritative_requirement": { "type": "string" },
          "permitted_claim": { "type": "string" },
          "prohibited_inference": { "type": "string" },
          "minimum_provenance": { "type": "string" },
          "required_environment": { "type": "string" },
          "required_configuration": { "type": "string" },
          "required_data_context": { "type": "string" },
          "required_identity_authority_context": { "type": "string" },
          "independence_requirement": { "type": "string" },
          "review_authority": { "type": "string" },
          "acceptance_authority": { "type": "string" },
          "expiry_or_revalidation_dependency": { "type": "string" },
          "evidentiary_limitation": { "type": "string" },

          "decision_class": { "$ref": "common.schema.json#/definitions/decisionClass" },
          "decision_authority": { "type": "string" },
          "required_competence": { "type": "string" },
          "required_independence": { "type": "string" },
          "permitted_inputs": { "type": "string" },
          "required_evidence": { "type": "string" },
          "permitted_disposition": { "type": "string" },
          "conflict_of_interest_treatment": { "type": "string" },
          "delegation_rule": { "type": "string" },
          "escalation_path": { "type": "string" },
          "reconsideration_rule": { "type": "string" },
          "revocation_rule": { "type": "string" },
          "downstream_gate": { "type": "string" },
          "segregation_boundary": { "type": "string" },

          "acceptance_class": { "$ref": "common.schema.json#/definitions/acceptanceClass" },
          "reviewer_qualification": { "type": "string" },
          "conditions_permitted": { "type": "string" },
          "dissent_treatment": { "type": "string" },
          "outstanding_obligation_treatment": { "type": "string" },
          "release_effect": { "type": "string" },

          "gate_criterion_reference": { "type": "string" },
          "gate_disposition_target": { "type": "string" },
          "authority_scope": { "type": "string" },
          "authority_domain": { "$ref": "common.schema.json#/definitions/authorityDomain" },
          "independence_level": { "$ref": "common.schema.json#/definitions/independenceLevel" },

          "institutional_invariant": { "type": "string" },
          "affected_actors": { "type": "string" },
          "house_responsibility": { "type": "string" },
          "button_responsibility": { "type": "string" },
          "external_system_responsibility": { "type": "string" },
          "required_evidence_classes": { "type": "string" },
          "required_test_or_procedure_levels": { "type": "string" },
          "environment_dependency": { "type": "string" },
          "configuration_dependency": { "type": "string" },
          "data_dependency": { "type": "string" },
          "provider_dependency": { "type": "string" },
          "dossier_destination": { "type": "string" },
          "governed_documentary_disposition": { "type": "string" },

          "required_capabilities": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "traces_to": { "type": "array", "items": { "type": "string" } },
          "deliverables": { "type": "array", "items": { "type": "string" } },

          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "evidence_label": { "$ref": "common.schema.json#/definitions/evidenceLabel" },
          "authorizes_implementation": { "type": "boolean", "const": false },
          "authorizes_operations": { "type": "boolean", "const": false },
          "authorizes_release": { "type": "boolean", "const": false },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "operational_status": { "$ref": "common.schema.json#/definitions/operationalStatus" },
          "execution_status": { "$ref": "common.schema.json#/definitions/executionStatus" },
          "evidence_status": { "$ref": "common.schema.json#/definitions/evidenceStatus" },
          "acceptance_status": { "$ref": "common.schema.json#/definitions/acceptanceStatus" },
          "release_status": { "$ref": "common.schema.json#/definitions/releaseStatus" },
          "chapter_ref": { "type": "string" },
          "future_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
