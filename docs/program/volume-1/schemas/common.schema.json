{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Volume 1 common definitions",
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registerStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "evidenceLabel": {
      "type": ["string", "null"],
      "enum": [
        "AUTHOR-VERIFIED",
        "SELF-ATTESTED",
        "SELF-ATTESTED / AUTHOR-VERIFIED",
        "DOMAIN-VALIDATED",
        "PEER-REVIEWED",
        "AUTOMATED-EVIDENCE",
        "INDEPENDENTLY-ASSESSED",
        "EXECUTIVE-ACCEPTED",
        "PRODUCTION-PROVEN",
        null
      ]
    },
    "decisionClass": {
      "type": "string",
      "pattern": "^D[0-9]$"
    },
    "v1GateId": {
      "type": "string",
      "pattern": "^V1-G[0-9]$"
    },
    "isoDateOrTbd": {
      "type": "string",
      "pattern": "^(TBD|[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?|.+)$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^V1-([0-9]{2}|[A-Z])(-[A-Z0-9]+)?$"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "ADOPT",
        "ADAPT",
        "CONSOLIDATE",
        "RETAIN",
        "REBUILD",
        "DEFER",
        "EXTERNALIZE",
        "RETIRE"
      ]
    },
    "targetLayer": {
      "type": "string",
      "enum": ["experience", "domain", "data_authority", "integration"]
    },
    "sourceContribution": {
      "type": "string",
      "enum": [
        "Base44",
        "The House",
        "ecosystem/current process",
        "external system"
      ]
    },
    "evidenceRating": {
      "type": "string",
      "enum": ["E0", "E1", "E2", "E3", "E4"]
    },
    "sourceClassification": {
      "type": "string",
      "enum": [
        "policy_truth",
        "operational_truth",
        "implementation_truth",
        "contractual_truth",
        "vendor_claim",
        "observed_evidence",
        "stakeholder_statement",
        "assumption",
        "unresolved_contradiction"
      ]
    }
  }
}
