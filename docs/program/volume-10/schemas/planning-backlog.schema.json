{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "planning-backlog.schema.json",
  "title": "REG-1004 Assumptions, Risks, Issues, Changes, Commitments, Estimates, and Planning Backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-1004" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "statement",
          "owner",
          "current_status",
          "impact_if_unresolved",
          "required_action_or_evidence",
          "validation_status",
          "authorizes_implementation",
          "implementation_status",
          "future_blocking_gate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(ASM|RISK|ISSUE|CHANGE|COMMIT|COST|FUND|PROC)-V10-[0-9]{3}$" },
          "kind": { "$ref": "common.schema.json#/definitions/backlogKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "source": { "type": "string" },
          "affected_objective": { "type": "string" },
          "affected_work_packages": { "type": "array", "items": { "type": "string" } },
          "affected_wave": { "type": "string" },
          "owner": { "type": "string" },
          "current_status": { "type": "string" },
          "impact_if_unresolved": { "type": "string" },
          "required_action_or_evidence": { "type": "string" },
          "target_resolution_window": { "type": "string" },
          "fallback_status": { "type": "string" },
          "likelihood_or_occurrence": { "type": "string" },
          "authority_impact": { "type": "string" },
          "security_impact": { "type": "string" },
          "privacy_impact": { "type": "string" },
          "accessibility_impact": { "type": "string" },
          "bilingual_impact": { "type": "string" },
          "data_impact": { "type": "string" },
          "financial_impact": { "type": "string" },
          "schedule_impact": { "type": "string" },
          "operational_impact": { "type": "string" },
          "escalation_threshold": { "type": "string" },
          "estimate_basis": { "type": "string" },
          "range": { "type": "string" },
          "confidence": { "$ref": "common.schema.json#/definitions/confidence" },
          "assumptions": { "type": "string" },
          "included_scope": { "type": "string" },
          "excluded_scope": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "source_date": { "$ref": "common.schema.json#/definitions/isoDate" },
          "currency": { "type": "string" },
          "tax_treatment_status": { "type": "string" },
          "contingency_posture": { "type": "string" },
          "operating_or_capital_treatment": { "type": "string" },
          "approval_status": { "type": "string" },
          "estimate_status": { "$ref": "common.schema.json#/definitions/estimateStatus" },
          "commitment_status": { "$ref": "common.schema.json#/definitions/commitmentStatus" },
          "planning_status": { "$ref": "common.schema.json#/definitions/planningStatus" },
          "traces_to": { "type": "array", "items": { "type": "string" } },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "authorizes_implementation": { "const": false },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "future_blocking_gate": { "$ref": "common.schema.json#/definitions/futureGateId" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "COST_ESTIMATE" } } },
            "then": {
              "required": [
                "estimate_basis",
                "range",
                "confidence",
                "assumptions",
                "included_scope",
                "excluded_scope",
                "source_date",
                "currency",
                "approval_status",
                "estimate_status"
              ]
            }
          },
          {
            "if": { "properties": { "kind": { "const": "COMMITMENT" } } },
            "then": { "required": ["commitment_status"] }
          },
          {
            "if": { "properties": { "kind": { "const": "PROCUREMENT" } } },
            "then": { "required": ["approval_status", "commitment_status"] }
          }
        ]
      }
    }
  }
}
