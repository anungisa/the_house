{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Volume 10 common definitions",
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registerStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentId": {
      "type": "string",
      "pattern": "^V10-([0-9]{2}|[A-Z])(-[A-Z0-9]+)?$"
    },
    "v10GateId": {
      "type": "string",
      "pattern": "^V10-G[0-9]$"
    },
    "futureGateId": {
      "type": "string",
      "pattern": "^(V10-G[0-9]|V1[12]-G[0-9]|EXEC-MCG)$"
    },
    "evidenceLabel": {
      "type": ["string", "null"],
      "enum": [
        "AUTHOR-VERIFIED",
        "SELF-ATTESTED",
        "SELF-ATTESTED / AUTHOR-VERIFIED",
        "DOMAIN-VALIDATED",
        "PEER-REVIEWED",
        "AUTOMATED-EVIDENCE",
        "INDEPENDENTLY-ASSESSED",
        "EXECUTIVE-ACCEPTED",
        "PRODUCTION-PROVEN",
        null
      ]
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$"
    },
    "implementationStatus": {
      "type": "string",
      "enum": ["NOT_IMPLEMENTED_OR_NOT_PROVEN"]
    },
    "planningStatus": {
      "type": "string",
      "enum": ["DOCUMENTARY_PLAN_ONLY"]
    },
    "commitmentStatus": {
      "type": "string",
      "enum": ["NOT_COMMITTED"]
    },
    "estimateStatus": {
      "type": "string",
      "enum": ["PLANNING_ESTIMATE"]
    },
    "authorityDomain": {
      "type": "string",
      "enum": ["House", "CurlingCanada", "Button", "External", "Internal", "Provider", "Staff", "Shared", "Independent", "Neither"]
    },
    "deliveryPhase": {
      "type": "string",
      "enum": [
        "DEFINITION",
        "QUALIFICATION",
        "PLANNING",
        "ENABLEMENT",
        "IMPLEMENTATION_READINESS",
        "IMPLEMENTATION_AUTHORIZATION",
        "CONSTRUCTION",
        "VERIFICATION",
        "RELEASE_CANDIDATE_FORMATION",
        "OPERATIONAL_READINESS",
        "RELEASE_ACCEPTANCE",
        "DEPLOYMENT",
        "STABILIZATION"
      ]
    },
    "planningLevel": {
      "type": "string",
      "enum": [
        "PROGRAM_OUTCOME",
        "DELIVERY_OBJECTIVE",
        "CAPABILITY",
        "WORKSTREAM",
        "WORK_PACKAGE",
        "DELIVERABLE",
        "TASK_CLASS",
        "EVIDENCE_OBLIGATION",
        "ACCEPTANCE_CRITERION"
      ]
    },
    "capabilityDomain": {
      "type": "string",
      "enum": [
        "EXECUTIVE_SPONSORSHIP",
        "PRODUCT_SERVICE_OWNERSHIP",
        "DOMAIN_OWNERSHIP",
        "ARCHITECTURE",
        "APPLICATION_ENGINEERING",
        "DATA_ENGINEERING",
        "SECURITY",
        "PRIVACY_AND_RECORDS",
        "ACCESSIBILITY",
        "BILINGUAL_CONTENT",
        "QUALITY_ENGINEERING",
        "INFRASTRUCTURE_AND_CLOUD",
        "MIGRATION",
        "OPERATIONS_AND_SUPPORT",
        "FINANCE",
        "PROCUREMENT",
        "CHANGE_AND_ADOPTION",
        "INDEPENDENT_ASSURANCE"
      ]
    },
    "dependencyKind": {
      "type": "string",
      "enum": [
        "ASSUMPTION",
        "DEPENDENCY",
        "CONSTRAINT",
        "DECISION",
        "COMMITMENT",
        "MATERIAL_COMMITMENT",
        "RISK",
        "ISSUE",
        "BLOCKER",
        "READINESS_CONDITION"
      ]
    },
    "relationshipKind": {
      "type": "string",
      "enum": [
        "HARD_PREREQUISITE",
        "SOFT_PREREQUISITE",
        "PARALLELIZABLE",
        "EVIDENCE_DEPENDENCY",
        "POLICY_DEPENDENCY",
        "PROVIDER_DEPENDENCY",
        "ENVIRONMENT_DEPENDENCY",
        "MIGRATION_DEPENDENCY",
        "OPERATIONAL_DEPENDENCY",
        "RELEASE_DEPENDENCY"
      ]
    },
    "criticalPathStatus": {
      "type": "string",
      "enum": ["ON_CRITICAL_PATH", "NEAR_CRITICAL_PATH", "OFF_CRITICAL_PATH"]
    },
    "scheduleConfidenceStatus": {
      "type": "string",
      "enum": ["INDICATIVE_ONLY", "LOW", "MEDIUM", "HIGH", "UNCOMMITTED"]
    },
    "environmentClass": {
      "type": "string",
      "enum": [
        "LOCAL_DEVELOPMENT",
        "COMPONENT_TEST",
        "INTEGRATION_TEST",
        "SYSTEM_TEST",
        "PRE_PRODUCTION",
        "PRODUCTION_PATH_VALIDATION",
        "RECOVERY_EXERCISE",
        "INDEPENDENT_ASSURANCE"
      ]
    },
    "provisioningStatus": {
      "type": "string",
      "enum": ["NOT_AUTHORIZED", "AUTHORIZED", "PROVISIONED", "QUALIFIED"]
    },
    "releaseUnitState": {
      "type": "string",
      "enum": [
        "DEFINED",
        "ASSEMBLED",
        "RELEASE_CANDIDATE_DEFINED",
        "RELEASE_CANDIDATE_ACCEPTED",
        "DEPLOYED"
      ]
    },
    "readinessDisposition": {
      "type": "string",
      "enum": [
        "PLANNING_DEFINED",
        "ACCEPTED_AS_VOLUME_11_INPUT",
        "ACCEPTED_AS_VOLUME_12_INPUT",
        "WORK_PACKAGE_DESTINATION_ASSIGNED",
        "GOVERNED_DISPOSITION_RECORDED",
        "DEPENDENCY_RESOLUTION_PENDING",
        "DECISION_PENDING",
        "EVIDENCE_REQUIRED",
        "ENVIRONMENT_QUALIFICATION_PENDING",
        "MATERIAL_COMMITMENT_PENDING",
        "IMPLEMENTATION_EVIDENCE_REQUIRED"
      ]
    },
    "decisionKind": {
      "type": "string",
      "enum": ["DECISION", "RECOMMENDED_DECISION", "DECISION_BOUNDARY"]
    },
    "decisionStatus": {
      "type": "string",
      "enum": ["RECOMMENDED", "PROPOSED", "APPROVED_FOR_PLANNING", "PENDING", "DEFERRED"]
    },
    "backlogKind": {
      "type": "string",
      "enum": [
        "ASSUMPTION",
        "RISK",
        "ISSUE",
        "CHANGE",
        "COMMITMENT",
        "COST_ESTIMATE",
        "FUNDING",
        "PROCUREMENT"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "INDICATIVE_ONLY"]
    },
    "validationStatus": {
      "type": "string",
      "enum": ["DEFINED", "CONSTRAINED", "ASSUMED", "PENDING_VALIDATION", "DEFERRED"]
    },
    "dataClassification": {
      "type": "string",
      "enum": [
        "SYNTHETIC",
        "ANONYMIZED",
        "PSEUDONYMIZED",
        "MASKED",
        "REAL_PERSONAL_INFORMATION",
        "REAL_FINANCIAL",
        "REAL_RESTRICTED_EVIDENCE",
        "NOT_APPLICABLE"
      ]
    }
  }
}
