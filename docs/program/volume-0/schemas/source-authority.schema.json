{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source-authority.schema.json",
  "title": "REG-005 Source and Authority Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-005" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_name", "source_type", "authority_level", "owner", "applicable_scope"],
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-[0-9]{3}$" },
          "source_name": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": [
              "policy",
              "governance_decision",
              "target_platform_current_implementation_truth",
              "reference_case_evidence",
              "authoritative_source_external",
              "synchronization_partner",
              "execution_plane",
              "projection_source",
              "reporting_source",
              "temporary_transition_platform",
              "replaceable_provider"
            ]
          },
          "authority_level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "owner": { "type": "string" },
          "applicable_scope": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
