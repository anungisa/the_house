{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "measures.schema.json",
  "title": "REG-008 Measures Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-008" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "baseline", "target", "owner", "method", "evidence_source"],
        "properties": {
          "id": { "type": "string", "pattern": "^OUT-[0-9]{3}$" },
          "baseline": { "type": "string" },
          "target": { "type": "string" },
          "owner": { "type": "string" },
          "method": { "type": "string" },
          "evidence_source": { "type": "string" },
          "review_cadence": { "type": "string" }
        }
      }
    }
  }
}
