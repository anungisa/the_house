{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test-model.schema.json",
  "title": "REG-902 Test Requirements, Scenarios, Cases, Oracles, Evidence, and Results",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-902" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "statement", "validation_status", "authorizes_implementation", "implementation_status", "chapter_ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^(TESTREQ|SCENARIO|CASE|ORACLE|ENV|DATASET|EVID|RESULT)-V9-[0-9]{3}$" },
          "kind": { "$ref": "common.schema.json#/definitions/testModelKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "source_requirement": { "type": "string" },
          "object_under_test": { "type": "string" },
          "institutional_invariant_ref": { "type": "string" },
          "applicable_test_level": { "$ref": "common.schema.json#/definitions/testLevel" },
          "expected_outcome": { "type": "string" },
          "negative_outcome": { "type": "string" },
          "evidence_tier_required": { "$ref": "common.schema.json#/definitions/evidenceTier" },
          "independence_requirement": { "$ref": "common.schema.json#/definitions/independenceLevel" },
          "actor_or_service": { "type": "string" },
          "tenant_context": { "type": "string" },
          "jurisdiction_context": { "type": "string" },
          "resource_context": { "type": "string" },
          "lifecycle_state_context": { "type": "string" },
          "scenario_disposition": { "type": "string" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "action_or_stimulus": { "type": "string" },
          "expected_result_oracle_ref": { "type": "string" },
          "authoritative_basis": { "type": "string" },
          "derived_from": { "type": "string" },
          "prohibited_basis": { "type": "string" },
          "environment_class": { "$ref": "common.schema.json#/definitions/environmentClass" },
          "permitted_test_families": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/testLevel" } },
          "data_classification": { "$ref": "common.schema.json#/definitions/dataClassification" },
          "production_data_prohibition": { "type": "string" },
          "provisioning_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "data_category": { "type": "string" },
          "minimization_posture": { "type": "string" },
          "provenance_requirement": { "type": "string" },
          "configuration_requirement": { "type": "string" },
          "environment_requirement": { "type": "string" },
          "version_requirement": { "type": "string" },
          "reproducibility_requirement": { "type": "string" },
          "disposition_values": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/resultDisposition" } },
          "inconclusive_distinct_from_pass": { "type": "boolean" },
          "acceptance_authority": { "type": "string" },
          "future_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "authorizes_implementation": { "const": false },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "chapter_ref": { "type": "string" },
          "traces_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
