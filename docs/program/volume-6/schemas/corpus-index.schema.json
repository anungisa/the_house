{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "corpus-index.schema.json",
  "title": "REG-600 Volume 6 Corpus Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-600" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "owner", "approver", "status", "version", "path", "gate"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/documentId" },
          "title": { "type": "string" },
          "owner": { "type": "string" },
          "approver": { "type": "string" },
          "status": { "$ref": "common.schema.json#/definitions/documentStatus" },
          "version": { "$ref": "common.schema.json#/definitions/semver" },
          "path": { "type": "string", "pattern": "^docs/program/volume-6/.+\\.md$" },
          "gate": { "$ref": "common.schema.json#/definitions/v6GateId" }
        }
      }
    }
  }
}
