          "user_need": { "type": "string" },
          "affected_workflow": { "type": "string" },
          "required_behaviour": { "type": "string" },
          "semantic_dependency": { "type": "string" },
          "accessibility_evidence": { "type": "string" },
          "verification_method": { "type": "string" },
          "operational_proof_dependency": { "type": "string" },

          "affected_content": { "type": "string" },
          "equivalent_concept": { "type": "string" },
          "semantic_equivalence": { "type": "string" },

          "trigger": { "type": "string" },
          "severity_classification_status": { "type": "string" },
          "evidence_preservation": { "type": "string" },
          "privacy_considerations": { "type": "string" },
          "notification_dependency": { "type": "string" },
          "containment_objective": { "type": "string" },
          "recovery_objective": { "type": "string" },
          "decision_authority": { "type": "string" },
          "operational_owner_status": { "type": "string" },
          "closure_evidence": { "type": "string" },
          "post_incident_review": { "type": "string" },

          "confidence": {
            "type": "string",
