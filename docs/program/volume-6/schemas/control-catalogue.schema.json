          "operational_proof_requirement": { "type": "string" },

          "records_authority": { "type": "string" },
          "retention_policy_status": { "type": "string" },
          "legal_hold_dependency": { "type": "string" },
          "archival_posture": { "type": "string" },
          "disposition_authority": { "type": "string" },
          "deletion_evidence_requirement": { "type": "string" },
          "provider_records_dependency": { "type": "string" },
          "permitted_actor": { "type": "string" },
          "prohibited_actor": { "type": "string" },
          "segregation_rule": { "type": "string" },
          "required_approval": { "type": "string" },
          "user_barrier": { "type": "string" },
          "permitted_accommodation": { "type": "string" },
          "support_role": { "type": "string" },
          "minimum_necessary_information": { "type": "string" },
          "equivalent_outcome_requirement": { "type": "string" },
          "expiry_or_review": { "type": "string" },
          "prohibited_inference": { "type": "string" },
          "defect_classification": { "type": "string" },
          "remediation_evidence": { "type": "string" },
          "retest_requirement": { "type": "string" },
          "reviewer_qualification_status": { "type": "string" },
          "alternative_representation": { "type": "string" },
          "document_accessibility_dependency": { "type": "string" },
          "provider_dependency": { "type": "string" },
          "canonical_concept_id": { "type": "string" },
          "english_expression": { "type": "string" },
          "french_expression": { "type": "string" },
          "deprecated_expression": { "type": "string" },
          "replacement_expression": { "type": "string" },
          "language_neutral_identifier": { "type": "string" },

          "monitoring_dependency": { "type": "string" },
          "failure_condition": { "type": "string" },
          "escalation_dependency": { "type": "string" },
          "review_dependency": { "type": "string" },
          "assurance_dependency": { "type": "string" },
