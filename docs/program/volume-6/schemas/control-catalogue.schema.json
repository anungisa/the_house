          "event_source": { "type": "string" },
          "detection_objective": { "type": "string" },
          "required_context": { "type": "string" },
          "triage_authority": { "type": "string" },
          "investigation_authority": { "type": "string" },
          "privacy_constraint": { "type": "string" },
          "false_positive_posture": { "type": "string" },
          "escalation_condition": { "type": "string" },
          "incident_linkage": { "type": "string" },
          "classification_authority": { "type": "string" },
          "incident_command_status": { "type": "string" },
          "business_authority_boundary": { "type": "string" },
          "privacy_authority_dependency": { "type": "string" },
          "records_authority_dependency": { "type": "string" },
          "recovery_dependency": { "type": "string" },
          "closure_authority": { "type": "string" },
          "affected_party": { "type": "string" },
          "potential_notification_obligation": { "type": "string" },
          "legal_validation_dependency": { "type": "string" },
          "contractual_dependency": { "type": "string" },
          "minimum_necessary_disclosure": { "type": "string" },
          "communication_authority": { "type": "string" },
          "language_and_accessibility_requirement": { "type": "string" },
          "records_requirement": { "type": "string" },
          "detection_source": { "type": "string" },
          "classification_method_status": { "type": "string" },
          "risk_owner": { "type": "string" },
          "remediation_owner_status": { "type": "string" },
          "expiry_requirement": { "type": "string" },
          "deployment_dependency": { "type": "string" },
          "dependency": { "type": "string" },
          "authority_retained": { "type": "string" },
          "failure_detection_requirement": { "type": "string" },
          "permitted_operations": { "type": "string" },
          "prohibited_operations": { "type": "string" },
          "data_integrity_requirement": { "type": "string" },
          "user_visible_status_dependency": { "type": "string" },
          "reconciliation_requirement": { "type": "string" },
          "audit_evidence": { "type": "string" },
          "authoritative_source": { "type": "string" },
          "backup_dependency": { "type": "string" },
          "protection_requirement": { "type": "string" },
