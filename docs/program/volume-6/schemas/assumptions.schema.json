{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "assumptions.schema.json",
  "title": "REG-604 Volume 6 Assumptions, Risks, Exceptions, and Validation Backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-604" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "owner", "validation_status", "authorizes_implementation", "implementation_status", "chapter_ref"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(ASM|RISK|EXC|TEST)-V6-[0-9]{3}$"
          },
          "kind": { "$ref": "common.schema.json#/definitions/backlogKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "owner": { "type": "string" },
          "authorizes_implementation": { "type": "boolean" },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "chapter_ref": { "$ref": "common.schema.json#/definitions/documentId" },
          "protected_asset_or_right": { "type": "string" },
          "control_owner": { "type": "string" },
          "control_operator_status": { "type": "string" },
          "classification": { "$ref": "common.schema.json#/definitions/classificationCategory" },
          "assurance_classification": { "$ref": "common.schema.json#/definitions/assuranceClassification" },
          "current_evidence": { "type": "string" },
          "required_evidence": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          },
          "exception_authority": { "type": "string" },
          "exception_expiry": { "type": "string" },
          "required_decision": { "type": "string" },
          "future_test_class": { "type": "string" },
          "target_package_or_volume": { "type": "string" },
          "downstream_volume": { "type": "string" },
          "readiness_disposition": { "type": "string" },
          "p0_finding": { "type": "string" },
          "definition_status": { "type": "string" },
          "required_environment": { "type": "string" },
          "operational_evidence": { "type": "string" },
          "implementation_evidence": { "type": "string" },
          "independent_assurance_dependency": { "type": "string" },
          "privacy_dependency": { "type": "string" },
          "accessibility_or_bilingual_dependency": { "type": "string" },
          "future_blocking_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "superseded_future_blocking_gate": {
            "oneOf": [
              { "$ref": "common.schema.json#/definitions/v6GateId" },
              { "type": "array", "items": { "$ref": "common.schema.json#/definitions/v6GateId" } }
            ]
          },
          "gate_reassignment_ref": { "type": "string" },
          "implementation_implication": { "type": "string" },
          "traces_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
