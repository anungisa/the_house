{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "data-rules-controls.schema.json",
  "title": "REG-502 Volume 5 Data Rules and Controls",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-502" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "statement", "validation_status", "authorizes_implementation", "chapter_ref"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(RULE|QUALITY|LINEAGE|CTRL|INTEG)-V5-[0-9]{3}$"
          },
          "kind": { "$ref": "common.schema.json#/definitions/ruleKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "authorizes_implementation": { "type": "boolean" },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "chapter_ref": { "$ref": "common.schema.json#/definitions/documentId" },
          "affected_domains": { "type": "array", "items": { "type": "string" } },
          "traces_to": { "type": "array", "items": { "type": "string" } },
          "authority_owner": { "$ref": "common.schema.json#/definitions/authorityDomain" },
          "stewardship_implication": { "type": "string" },
          "control_implication": { "type": "string" },
          "downstream_constraint": { "type": "string" },

          "quality_dimension": { "$ref": "common.schema.json#/definitions/qualityDimension" },
          "detection_concept": { "type": "string" },
          "correction_authority": { "type": "string" },
          "correction_type": { "type": "string" },
          "reconciliation_source": { "type": "string" },
          "evidence_retained": { "type": "string" },
          "downstream_impact": { "type": "string" },
          "future_blocking_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "superseded_future_blocking_gate": {
            "oneOf": [
              { "$ref": "common.schema.json#/definitions/v5GateId" },
              { "type": "array", "items": { "$ref": "common.schema.json#/definitions/v5GateId" } }
            ]
          },
          "gate_reassignment_ref": { "type": "string" },

          "affected_entities": { "type": "array", "items": { "type": "string" } },
          "logical_condition": { "type": "string" },
          "failure_meaning": { "type": "string" },
          "future_verification_class": { "type": "string" },

          "authoritative_fact": { "type": "string" },
          "source": { "type": "string" },
          "transformation_lineage": { "type": "string" },
          "retention_dependency": { "type": "string" },
          "audit_expectation": { "type": "string" },

          "rule_lifecycle_stage": { "type": "string" },
          "issue_classification": { "type": "string" },
          "resolution_authority": { "type": "string" },
          "exception_authority": { "type": "string" },
          "exception_expiry": { "type": "string" },
          "measurement_status": { "type": "string" },
          "target_status": { "type": "string" },
          "conflict_authority": { "type": "string" },
          "purpose_limitation": { "type": "string" },
          "minimization_posture": { "type": "string" },
          "disclosure_authority": { "type": "string" },
          "operational_proof_requirement": { "type": "string" }
        }
      }
    }
  }
}
