{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decisions.schema.json",
  "title": "REG-503 Volume 5 Data Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-503" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "decision", "status", "validation_status", "authorizes_implementation", "chapter_ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-V5-[0-9]{3}$" },
          "title": { "type": "string" },
          "decision": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED", "DEFERRED"]
          },
          "context": { "type": "string" },
          "consequence": { "type": "string" },
          "authorizes_implementation": { "type": "boolean" },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "chapter_ref": { "$ref": "common.schema.json#/definitions/documentId" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "traces_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
