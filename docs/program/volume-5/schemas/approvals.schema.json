{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "approvals.schema.json",
  "title": "REG-505 Volume 5 Approval Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-505" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifact_id", "approver_role", "approval_state", "evidence_label", "authorizes_implementation", "conditions"],
        "properties": {
          "id": { "type": "string", "pattern": "^APP-V5-[0-9]{3}$" },
          "artifact_id": {
            "type": "string",
            "pattern": "^(V5-([0-9]{2}|[A-Z])|PACKAGE-5-[0-9]|VOLUME-5|ADR-V5-[0-9]{3}|GATE-V5-G[0-9])$"
          },
          "approver_role": { "type": "string" },
          "approval_state": {
            "type": "string",
            "enum": ["authorized", "ratified", "withdrawn", "expired", "executive_accepted"]
          },
          "evidence_label": { "$ref": "common.schema.json#/definitions/evidenceLabel" },
          "authorizes_implementation": { "type": "boolean" },
          "finding": { "type": "string" },
          "gate_disposition": { "type": "string" },
          "scope": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/definitions/documentId" }
          },
          "conditions": { "type": "array", "items": { "type": "string" } },
          "closure_record": { "type": "string", "pattern": "^V5-[A-Z]$" },
          "base_commit": { "type": "string" },
          "amendment_process": { "type": "string" },
          "supersedes": { "type": "string" },
          "package_provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_snapshot_commit": { "type": "string" },
              "closure_freeze_commit": { "type": "string" },
              "merged_commit": { "type": "string" },
              "original_package_merge_commit": { "type": "string" },
              "provenance_amendment_commit": { "type": "string" },
              "release_merge_commit": { "type": "string" },
              "release_tag": { "type": "string" },
              "release_tag_object": { "type": "string" },
              "release_tag_target_commit": { "type": "string" },
              "inherited_baseline_tag": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "frozen": { "type": "boolean" },
          "frozen_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": { "$ref": "common.schema.json#/definitions/documentId" },
                "version": { "$ref": "common.schema.json#/definitions/semver" }
              }
            }
          },
          "approved_at": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "common.schema.json#/definitions/isoDate" }
            ]
          }
        }
      }
    }
  }
}
