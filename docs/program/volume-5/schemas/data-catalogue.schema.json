          "records_authority": { "type": "string" },
          "privacy_dependency": { "type": "string" },
          "legal_hold_dependency": { "type": "string" },
          "archival_expectation": { "type": "string" },
          "disposition_authority": { "type": "string" },
          "deletion_authority": { "type": "string" },
          "external_dependency": { "type": "string" },

          "issue_classification": { "type": "string" },
