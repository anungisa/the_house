          "consistency_posture": { "type": "string" },
          "staleness_indicator": { "type": "string" },
          "reconciliation_rule": { "type": "string" },
          "export_lineage": { "type": "string" },
          "operational_ownership_status": { "type": "string" },
          "access_or_integrity_objective": { "type": "string" },
          "affected_relations": { "type": "array", "items": { "type": "string" } },
