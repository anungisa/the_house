{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Volume 5 common definitions",
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registerStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentId": {
      "type": "string",
      "pattern": "^V5-([0-9]{2}|[A-Z])(-[A-Z0-9]+)?$"
    },
    "v5GateId": {
      "type": "string",
      "pattern": "^V5-G[0-9]$"
    },
    "futureGateId": {
      "type": "string",
      "pattern": "^(V5-G[0-9]|V([6-9]|1[01])-G[0-9]|EXEC-MCG)$"
    },
    "evidenceLabel": {
      "type": ["string", "null"],
      "enum": [
        "AUTHOR-VERIFIED",
        "SELF-ATTESTED",
        "SELF-ATTESTED / AUTHOR-VERIFIED",
        "DOMAIN-VALIDATED",
        "PEER-REVIEWED",
        "AUTOMATED-EVIDENCE",
        "INDEPENDENTLY-ASSESSED",
        "EXECUTIVE-ACCEPTED",
        "PRODUCTION-PROVEN",
        null
      ]
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$"
    },
    "authorityDomain": {
      "type": "string",
      "enum": ["House", "CurlingCanada", "Button", "External", "Staff", "Shared", "Neither"]
    },
    "catalogueKind": {
      "type": "string",
      "enum": [
        "INFORMATION_DOMAIN",
        "CONCEPTUAL_ENTITY",
        "CONCEPTUAL_RELATIONSHIP",
        "DATA_PRODUCT",
        "CLASSIFICATION",
        "LOGICAL_ENTITY",
        "LOGICAL_RELATIONSHIP",
        "VALUE_OBJECT",
        "REFERENCE_DATA",
        "CODE_SET",
        "STATE_RECORD",
        "SNAPSHOT",
        "PROVENANCE_RECORD",
        "CORRECTION_RECORD",
        "DERIVED_DATA_PRODUCT",
        "MASTER_DATA_SET",
        "REFERENCE_DATA_SET",
        "CONTROLLED_TERM",
        "DATA_LIFECYCLE",
        "DATA_ISSUE",
        "RECONCILIATION_CONTEXT",
        "EXCHANGE_RECORD",
        "DATA_USE",
        "STEWARDSHIP_MEASURE",
        "RETENTION_DEPENDENCY"
      ]
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "MASTER_DATA",
        "REFERENCE_DATA",
        "TRANSACTIONAL_DATA",
        "LIFECYCLE_HISTORY",
        "EVIDENTIARY_DATA",
        "AUDIT_DATA",
        "DERIVED_DATA",
        "ANALYTICAL_DATA",
        "EXTERNAL_AUTHORITY_DATA",
        "TRANSITIONAL_DATA"
      ]
    },
    "lifecycleStage": {
      "type": "string",
      "enum": [
        "CREATED",
        "ACTIVE",
        "SUPERSEDED",
        "INACTIVE",
        "ARCHIVAL_ELIGIBLE",
        "ARCHIVED",
        "LEGAL_HOLD",
        "DISPOSITION_ELIGIBLE",
        "DISPOSITION_AUTHORIZED",
        "DISPOSED"
      ]
    },
    "ruleKind": {
      "type": "string",
      "enum": ["RULE", "QUALITY", "LINEAGE", "CTRL", "INTEGRITY"]
    },
    "backlogKind": {
      "type": "string",
      "enum": ["ASM", "RISK", "EXC", "VALIDATION"]
    },
    "classificationCategory": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "PERSONAL",
        "RESTRICTED_EVIDENCE",
        "FINANCIAL_STATUS",
        "PRIVILEGED_ADMIN",
        "SECURITY_AUDIT",
        "ANALYTICS_AGGREGATE"
      ]
    },
    "qualityDimension": {
      "type": "string",
      "enum": [
        "VALIDITY",
        "COMPLETENESS",
        "CONSISTENCY",
        "UNIQUENESS",
        "TIMELINESS",
        "ACCURACY",
        "TRACEABILITY",
        "AUTHORITY_ALIGNMENT",
        "JURISDICTION_ALIGNMENT",
        "TEMPORAL_CORRECTNESS"
      ]
    },
    "validationStatus": {
      "type": "string",
      "enum": [
        "DEFINED",
        "CONSTRAINED",
        "ASSUMED",
        "PENDING_VALIDATION",
        "DEFERRED"
      ]
    }
  }
}
