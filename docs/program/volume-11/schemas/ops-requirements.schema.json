{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ops-requirements.schema.json",
  "title": "REG-1102 Operational Requirements, Procedures, Scenarios, Evidence, Acceptance, and Handoffs",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-1102" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "statement",
          "validation_status",
          "authorizes_implementation",
          "authorizes_operations",
          "implementation_status",
          "operational_status",
          "execution_status",
          "chapter_ref",
          "future_gate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(SIGNAL|CONT|BACKUP|RESTORE|RECOVERY|MIG|RECON|TRAIN|ADOPT|EVID|ACCEPT|HANDOFF|PROC)-V11-[0-9]{3}$" },
          "kind": {
            "type": "string",
            "enum": [
              "OBSERVABILITY_SIGNAL",
              "OPERATIONAL_PROCEDURE",
              "CONTINUITY_SCENARIO",
              "BACKUP_REQUIREMENT",
              "RESTORE_REQUIREMENT",
              "RECOVERY_REQUIREMENT",
              "MIGRATION_STAGE",
              "RECONCILIATION_REQUIREMENT",
              "TRAINING_AUDIENCE",
              "ADOPTION_MEASURE",
              "EVIDENCE_REQUIREMENT",
              "ACCEPTANCE_CRITERION",
              "HANDOFF"
            ]
          },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "objective": { "type": "string" },
          "scope": { "type": "string" },
          "excluded_scope": { "type": "string" },
          "affected_service": { "type": "string" },
          "affected_capability": { "type": "string" },
          "signal_context": { "type": "string" },
          "signal_sensitivity": { "$ref": "common.schema.json#/definitions/sensitivity" },
          "signal_owner": { "type": "string" },
          "alert_dependency": { "type": "string" },
          "evidence_binding": { "type": "string" },
          "detection_vs_response_distinction": { "type": "string" },
          "preserved_work": { "type": "string" },
          "prohibited_action": { "type": "string" },
          "degraded_mode": { "type": "string" },
          "fallback_procedure": { "type": "string" },
          "recovery_procedure": { "type": "string" },
          "continuity_distinction": { "type": "string" },
          "backup_completion_definition": { "type": "string" },
          "backup_verification_definition": { "type": "string" },
          "restoration_definition": { "type": "string" },
          "recovery_definition": { "type": "string" },
          "reconciliation_definition": { "type": "string" },
          "migration_stage": { "$ref": "common.schema.json#/definitions/migrationStage" },
          "source_authority_preservation": { "type": "string" },
          "provenance_preservation": { "type": "string" },
          "uncertainty_preservation": { "type": "string" },
          "identity_candidate_treatment": { "type": "string" },
          "quarantine_treatment": { "type": "string" },
          "rehearsal_boundary": { "type": "string" },
          "cutover_boundary": { "type": "string" },
          "acceptance_boundary": { "type": "string" },
          "rollback_definition": { "type": "string" },
          "source_retirement_boundary": { "type": "string" },
          "mapping_vs_identity_distinction": { "type": "string" },
          "training_content": { "type": "string" },
          "training_delivery": { "type": "string" },
          "competence_definition": { "type": "string" },
          "onboarding_definition": { "type": "string" },
          "sustained_adoption_definition": { "type": "string" },
          "accessibility_obligation": { "type": "string" },
          "bilingual_obligation": { "type": "string" },
          "evidence_binds_environment": { "type": "string" },
          "evidence_binds_config": { "type": "string" },
          "evidence_binds_version": { "type": "string" },
          "evidence_binds_identity": { "type": "string" },
          "evidence_binds_org": { "type": "string" },
          "evidence_binds_jurisdiction": { "type": "string" },
          "evidence_binds_data_classification": { "type": "string" },
          "evidence_binds_provider_state": { "type": "string" },
          "evidence_binds_time": { "type": "string" },
          "independence_requirement": { "$ref": "common.schema.json#/definitions/independenceLevel" },
          "acceptance_authority": { "type": "string" },
          "handoff_destination": { "type": "string" },
          "handoff_target_volume": { "type": "string" },
          "required_capabilities": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "traces_to": { "type": "array", "items": { "type": "string" } },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "evidence_label": { "$ref": "common.schema.json#/definitions/evidenceLabel" },
          "authorizes_implementation": { "type": "boolean", "const": false },
          "authorizes_operations": { "type": "boolean", "const": false },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "operational_status": { "$ref": "common.schema.json#/definitions/operationalStatus" },
          "execution_status": { "$ref": "common.schema.json#/definitions/executionStatus" },
          "chapter_ref": { "type": "string" },
          "future_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
