          "decision_authority": { "type": "string" },
          "exit_criteria": { "type": "string" },
          "state_scenario": { "type": "string" },
          "requester": { "type": "string" },
          "receiving_role": { "type": "string" },
          "triage_criteria": { "type": "string" },
          "authority_boundary": { "type": "string" },
          "minimum_necessary_access": { "type": "string" },
          "priority_method_dependency": { "type": "string" },
          "diagnostic_evidence": { "type": "string" },
          "communication_obligation": { "type": "string" },
          "privacy_restriction": { "type": "string" },
          "resolution_authority": { "type": "string" },
          "closure_evidence": { "type": "string" },
          "reopening_criteria": { "type": "string" },
