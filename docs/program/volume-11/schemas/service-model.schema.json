          "required_correlation_context": { "type": "string" },
          "alert_destination": { "type": "string" },
          "containment_action_class": { "type": "string" },
          "recovery_dependency": { "type": "string" },
          "reconciliation_requirement": { "type": "string" },
          "evidence_required": { "type": "string" },
          "institutional_owner": { "type": "string" },
          "contract_owner": { "type": "string" },
          "service_dependency": { "type": "string" },
          "data_custody": { "type": "string" },
          "authority_retained": { "type": "string" },
          "authentication_dependency": { "type": "string" },
          "authoritative_source": { "type": "string" },
          "detection_dependency": { "type": "string" },
          "institutional_decision_owner": { "type": "string" },
