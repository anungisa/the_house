{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Volume 8 common definitions",
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registerStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentId": {
      "type": "string",
      "pattern": "^V8-([0-9]{2}|[A-Z])(-[A-Z0-9]+)?$"
    },
    "v8GateId": {
      "type": "string",
      "pattern": "^V8-G[0-9]$"
    },
    "futureGateId": {
      "type": "string",
      "pattern": "^(V8-G[0-9]|V(9|1[012])-G[0-9]|EXEC-MCG)$"
    },
    "evidenceLabel": {
      "type": ["string", "null"],
      "enum": [
        "AUTHOR-VERIFIED",
        "SELF-ATTESTED",
        "SELF-ATTESTED / AUTHOR-VERIFIED",
        "DOMAIN-VALIDATED",
        "PEER-REVIEWED",
        "AUTOMATED-EVIDENCE",
        "INDEPENDENTLY-ASSESSED",
        "EXECUTIVE-ACCEPTED",
        "PRODUCTION-PROVEN",
        null
      ]
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$"
    },
    "implementationStatus": {
      "type": "string",
      "enum": ["NOT_IMPLEMENTED_OR_NOT_PROVEN"]
    },
    "authorityDomain": {
      "type": "string",
      "enum": ["House", "CurlingCanada", "Button", "External", "Internal", "Provider", "Staff", "Shared", "Neither"]
    },
    "interactionType": {
      "type": "string",
      "enum": [
        "SYNCHRONOUS_COMMAND",
        "SYNCHRONOUS_QUERY",
        "INTERNAL_MODULE_CONTRACT",
        "DOMAIN_EVENT",
        "INTEGRATION_EVENT",
        "NOTIFICATION_EVENT",
        "AUDIT_EVENT",
        "WEBHOOK",
        "PROVIDER_CALLBACK",
        "FILE_IMPORT",
        "FILE_EXPORT",
        "BATCH_EXCHANGE",
        "MIGRATION_EXCHANGE",
        "REPORTING_FEED",
        "ANALYTICS_FEED"
      ]
    },
    "deliveryPosture": {
      "type": "string",
      "enum": [
        "SYNCHRONOUS_REQUEST_RESPONSE",
        "AT_LEAST_ONCE",
        "AT_MOST_ONCE",
        "TRANSACTIONAL_OUTBOX",
        "SCHEDULED_BATCH",
        "MANUAL_EXCHANGE",
        "NOT_APPLICABLE"
      ]
    },
    "orderingRequirement": {
      "type": "string",
      "enum": ["NONE", "PER_AGGREGATE", "PER_PARTITION_SCOPE", "GLOBAL_NOT_PRESUMED"]
    },
    "idempotencyRequirement": {
      "type": "string",
      "enum": ["REQUIRED", "REQUIRED_PER_KEY", "DEDUPLICATION_REQUIRED", "NOT_APPLICABLE"]
    },
    "classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL_OPERATIONAL",
        "PERSONAL_INFORMATION",
        "RESTRICTED_EVIDENCE",
        "FINANCIAL_STATUS",
        "PRIVILEGED_ADMINISTRATION",
        "AUDIT_AND_SECURITY",
        "SECRETS_AND_CONFIGURATION",
        "MIGRATION_OR_QUARANTINE"
      ]
    },
    "sensitivityLevel": {
      "type": "string",
      "enum": ["LOW", "MODERATE", "HIGH", "RESTRICTED"]
    },
    "compatibilityState": {
      "type": "string",
      "enum": [
        "BACKWARD_COMPATIBLE",
        "FORWARD_COMPATIBLE",
        "BIDIRECTIONALLY_COMPATIBLE",
        "CONDITIONALLY_COMPATIBLE",
        "BREAKING_CHANGE",
        "DEPRECATION_PENDING",
        "REPLACEMENT_AVAILABLE",
        "SUNSET_VALIDATION_PENDING"
      ]
    },
    "surfaceKind": {
      "type": "string",
      "enum": [
        "CONTRACT_SURFACE",
        "PRODUCER",
        "CONSUMER",
        "TRUST_BOUNDARY",
        "PROVIDER_CONTEXT",
        "AUTHORIZATION_CONTEXT",
        "LOGICAL_RESOURCE",
        "EVENT_CONTRACT_SURFACE",
        "EVENT_PRODUCER_CONTEXT",
        "EVENT_CONSUMER_CONTEXT",
        "WEBHOOK_CONTEXT",
        "NOTIFICATION_CONTEXT",
        "DELIVERY_TRUST_BOUNDARY",
        "PROVIDER_CONTRACT_SURFACE",
        "IMPORT_CONTEXT",
        "EXPORT_CONTEXT",
        "FILE_EXCHANGE_CONTEXT",
        "BATCH_EXCHANGE_CONTEXT",
        "MIGRATION_CONTEXT",
        "MANUAL_EXCHANGE_CONTEXT",
        "PROVIDER_TRUST_BOUNDARY",
        "INTEGRATED_SURFACE_CATALOGUE_ENTRY"
      ]
    },
    "requirementKind": {
      "type": "string",
      "enum": [
        "COMMAND_CLASS",
        "QUERY_CLASS",
        "EVENT_CLASS",
        "WEBHOOK_CLASS",
        "EXCHANGE_CLASS",
        "MESSAGE_REQUIREMENT",
        "ERROR_SEMANTIC",
        "DELIVERY_REQUIREMENT",
        "IDEMPOTENCY_REQUIREMENT",
        "REPLAY_REQUIREMENT",
        "RECONCILIATION_REQUIREMENT",
        "COMPATIBILITY_RULE",
        "EVENT_CONTRACT",
        "EVENT_ENVELOPE_REQUIREMENT",
        "OUTBOX_REQUIREMENT",
        "DELIVERY_SEMANTIC",
        "CONSUMER_REQUIREMENT",
        "WEBHOOK_REQUIREMENT",
        "CALLBACK_REQUIREMENT",
        "DEDUPLICATION_REQUIREMENT",
        "ORDERING_REQUIREMENT",
        "QUARANTINE_REQUIREMENT",
        "NOTIFICATION_REQUIREMENT",
        "FILE_MANIFEST_REQUIREMENT",
        "BATCH_ENVELOPE_REQUIREMENT",
        "IMPORT_REQUIREMENT",
        "EXPORT_REQUIREMENT",
        "ACCEPTANCE_SEMANTIC",
        "REJECTION_SEMANTIC",
        "PARTIAL_SUCCESS_SEMANTIC",
        "MIGRATION_MAPPING_REQUIREMENT",
        "IDENTITY_RESOLUTION_REQUIREMENT",
        "PROVIDER_CONTINUITY_REQUIREMENT",
        "DATA_RETURN_REQUIREMENT",
        "DELETION_EVIDENCE_REQUIREMENT",
        "PROVIDER_EXIT_REQUIREMENT",
        "EXCHANGE_RECONCILIATION_REQUIREMENT",
        "CONTRACT_CAPABILITY",
        "P0_CONTRACT_COVERAGE",
        "DOWNSTREAM_HANDOFF"
      ]
    },
    "backlogKind": {
      "type": "string",
      "enum": ["ASM", "RISK", "EXC", "TEST", "READINESS"]
    },
    "readinessDisposition": {
      "type": "string",
      "enum": [
        "CLOSED_WITH_EVIDENCE",
        "ACCEPTED_AS_VOLUME_9_INPUT",
        "ACCEPTED_AS_VOLUME_10_INPUT",
        "ACCEPTED_AS_VOLUME_11_INPUT",
        "ACCEPTED_AS_VOLUME_12_INPUT",
        "MATERIAL_COMMITMENT_PENDING",
        "POLICY_VALIDATION_PENDING",
        "LEGAL_VALIDATION_PENDING",
        "CONTRACT_VALIDATION_PENDING",
        "PRIVACY_VALIDATION_PENDING",
        "RECORDS_VALIDATION_PENDING",
        "IMPLEMENTATION_EVIDENCE_REQUIRED",
        "MIGRATION_EVIDENCE_REQUIRED",
        "OPERATIONAL_PROOF_REQUIRED",
        "INDEPENDENT_ASSURANCE_REQUIRED",
        "DEFECT_REQUIRING_AMENDMENT"
      ]
    },
    "validationStatus": {
      "type": "string",
      "enum": ["DEFINED", "CONSTRAINED", "ASSUMED", "PENDING_VALIDATION", "DEFERRED"]
    }
  }
}
