{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Volume 8 common definitions",
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registerStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentStatus": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "RATIFIED", "SUPERSEDED", "WITHDRAWN"]
    },
    "documentId": {
      "type": "string",
      "pattern": "^V8-([0-9]{2}|[A-Z])(-[A-Z0-9]+)?$"
    },
    "v8GateId": {
      "type": "string",
      "pattern": "^V8-G[0-9]$"
    },
    "futureGateId": {
      "type": "string",
      "pattern": "^(V8-G[0-9]|V(9|1[012])-G[0-9]|EXEC-MCG)$"
    },
    "evidenceLabel": {
      "type": ["string", "null"],
      "enum": [
        "AUTHOR-VERIFIED",
        "SELF-ATTESTED",
        "SELF-ATTESTED / AUTHOR-VERIFIED",
        "DOMAIN-VALIDATED",
        "PEER-REVIEWED",
        "AUTOMATED-EVIDENCE",
        "INDEPENDENTLY-ASSESSED",
        "EXECUTIVE-ACCEPTED",
        "PRODUCTION-PROVEN",
        null
      ]
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$"
    },
    "implementationStatus": {
      "type": "string",
      "enum": ["NOT_IMPLEMENTED_OR_NOT_PROVEN"]
    },
    "authorityDomain": {
      "type": "string",
      "enum": ["House", "CurlingCanada", "Button", "External", "Internal", "Provider", "Staff", "Shared", "Neither"]
    },
    "interactionType": {
      "type": "string",
      "enum": [
        "SYNCHRONOUS_COMMAND",
        "SYNCHRONOUS_QUERY",
        "INTERNAL_MODULE_CONTRACT",
        "DOMAIN_EVENT",
        "INTEGRATION_EVENT",
        "NOTIFICATION_EVENT",
        "AUDIT_EVENT",
        "WEBHOOK",
        "PROVIDER_CALLBACK",
        "FILE_IMPORT",
        "FILE_EXPORT",
        "BATCH_EXCHANGE",
        "MIGRATION_EXCHANGE",
        "REPORTING_FEED",
        "ANALYTICS_FEED"
      ]
    },
    "deliveryPosture": {
      "type": "string",
      "enum": [
        "SYNCHRONOUS_REQUEST_RESPONSE",
        "AT_LEAST_ONCE",
        "AT_MOST_ONCE",
        "TRANSACTIONAL_OUTBOX",
        "SCHEDULED_BATCH",
        "MANUAL_EXCHANGE",
        "NOT_APPLICABLE"
      ]
    },
    "orderingRequirement": {
      "type": "string",
      "enum": ["NONE", "PER_AGGREGATE", "PER_PARTITION_SCOPE", "GLOBAL_NOT_PRESUMED"]
    },
    "idempotencyRequirement": {
      "type": "string",
      "enum": ["REQUIRED", "REQUIRED_PER_KEY", "DEDUPLICATION_REQUIRED", "NOT_APPLICABLE"]
    },
    "classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL_OPERATIONAL",
        "PERSONAL_INFORMATION",
        "RESTRICTED_EVIDENCE",
        "FINANCIAL_STATUS",
        "PRIVILEGED_ADMINISTRATION",
        "AUDIT_AND_SECURITY",
        "SECRETS_AND_CONFIGURATION",
        "MIGRATION_OR_QUARANTINE"
      ]
    },
    "sensitivityLevel": {
      "type": "string",
      "enum": ["LOW", "MODERATE", "HIGH", "RESTRICTED"]
    },
    "compatibilityState": {
      "type": "string",
      "enum": [
        "BACKWARD_COMPATIBLE",
        "FORWARD_COMPATIBLE",
        "BIDIRECTIONALLY_COMPATIBLE",
        "CONDITIONALLY_COMPATIBLE",
        "BREAKING_CHANGE",
        "DEPRECATION_PENDING",
        "REPLACEMENT_AVAILABLE",
        "SUNSET_VALIDATION_PENDING"
      ]
    },
    "surfaceKind": {
      "type": "string",
      "enum": [
        "CONTRACT_SURFACE",
        "PRODUCER",
        "CONSUMER",
        "TRUST_BOUNDARY",
        "PROVIDER_CONTEXT",
        "AUTHORIZATION_CONTEXT",
        "LOGICAL_RESOURCE"
      ]
    },
    "requirementKind": {
      "type": "string",
      "enum": [
        "COMMAND_CLASS",
        "QUERY_CLASS",
        "EVENT_CLASS",
        "WEBHOOK_CLASS",
        "EXCHANGE_CLASS",
        "MESSAGE_REQUIREMENT",
        "ERROR_SEMANTIC",
        "DELIVERY_REQUIREMENT",
        "IDEMPOTENCY_REQUIREMENT",
        "REPLAY_REQUIREMENT",
        "RECONCILIATION_REQUIREMENT",
        "COMPATIBILITY_RULE"
      ]
    },
    "backlogKind": {
      "type": "string",
      "enum": ["ASM", "RISK", "EXC", "TEST"]
    },
    "validationStatus": {
      "type": "string",
      "enum": ["DEFINED", "CONSTRAINED", "ASSUMED", "PENDING_VALIDATION", "DEFERRED"]
    }
  }
}
