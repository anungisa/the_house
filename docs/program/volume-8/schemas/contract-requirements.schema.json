{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contract-requirements.schema.json",
  "title": "REG-802 Contract Requirements, Messages, Errors, Delivery, and Compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-802" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "statement", "authorizes_implementation", "implementation_status", "validation_status", "chapter_ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^(COMMAND|QUERY|EVENT|WEBHOOK|EXCHANGE|BATCH|FILE|MESSAGE|ERROR|SCHEMA|IDEMP|RETRY|DELIV|REPLAY|RECON|CONTRACT|ENVELOPE|OUTBOX|CONSUMER|CALLBACK|DEDUP|ORDER|QUAR|NOTIFY|MANIFEST|BATCHENV|IMPORT|EXPORT|ACCEPT|REJECT|PARTIAL|MIGMAP|IDRES|PROVCONT|DATARET|DELEVID|PROVEXIT|EXRECON)-V8-[0-9]{3}$" },
          "kind": { "$ref": "common.schema.json#/definitions/requirementKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "interaction_type": { "$ref": "common.schema.json#/definitions/interactionType" },
          "institutional_authority": { "$ref": "common.schema.json#/definitions/authorityDomain" },
          "authoritative_source": { "type": "string" },
          "classification": { "$ref": "common.schema.json#/definitions/classification" },
          "sensitivity": { "$ref": "common.schema.json#/definitions/sensitivityLevel" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "result_semantics": { "type": "string" },
          "error_semantics": { "type": "string" },
          "acceptance_semantics": { "type": "string" },
          "completion_distinction": { "type": "string" },
          "staleness_posture": { "type": "string" },
          "source_posture": { "type": "string" },
          "envelope_fields": { "type": "array", "items": { "type": "string" } },
          "delivery_posture": { "$ref": "common.schema.json#/definitions/deliveryPosture" },
          "ordering_requirement": { "$ref": "common.schema.json#/definitions/orderingRequirement" },
          "idempotency_requirement": { "$ref": "common.schema.json#/definitions/idempotencyRequirement" },
          "idempotency_scope": { "type": "string" },
          "deduplication_scope": { "type": "string" },
          "concurrency_precondition": { "type": "string" },
          "replay_posture": { "type": "string" },
          "retry_posture": { "type": "string" },
          "exactly_once_business_invariant": { "type": "string" },
          "conflict_outcome": { "type": "string" },
          "authentication_requirement": { "type": "string" },
          "integrity_requirement": { "type": "string" },
          "reconciliation_dependency": { "type": "string" },
          "canonical_code": { "type": "string" },
          "retryable": { "type": "string", "enum": ["RETRYABLE", "NON_RETRYABLE", "CONDITIONAL"] },
          "user_safe_semantic": { "type": "string" },
          "correlation_requirement": { "type": "string" },
          "logging_constraint": { "type": "string" },
          "privacy_constraint": { "type": "string" },
          "support_boundary": { "type": "string" },
          "accept_reject_quarantine_semantics": { "type": "string" },
          "manifest_and_integrity": { "type": "string" },
          "duplicate_handling": { "type": "string" },
          "compatibility_state": { "$ref": "common.schema.json#/definitions/compatibilityState" },
          "consumer_evidence": { "type": "string" },
          "deprecation_rule": { "type": "string" },
          "evidence_requirement": { "type": "string" },
          "purpose": { "type": "string" },
          "organization_scope": { "type": "string" },
          "jurisdiction_scope": { "type": "string" },
          "triggering_transition": { "type": "string" },
          "expected_state": { "type": "string" },
          "permitted_transition": { "type": "string" },
          "atomicity_requirement": { "type": "string" },
          "publication_eligibility": { "type": "string" },
          "replay_authority": { "type": "string" },
          "replay_evidence": { "type": "string" },
          "replay_protection_dependency": { "type": "string" },
          "unknown_outcome_posture": { "type": "string" },
          "quarantine_posture": { "type": "string" },
          "compensation_limitation": { "type": "string" },
          "incident_linkage": { "type": "string" },
          "records_requirement": { "type": "string" },
          "acknowledgement_semantics": { "type": "string" },
          "freshness_dependency": { "type": "string" },
          "escalation_dependency": { "type": "string" },
          "channel_dependency": { "type": "string" },
          "disclosure_authority": { "type": "string" },
          "audience": { "type": "string" },
          "minimum_necessary_content": { "type": "string" },
          "content_minimization": { "type": "string" },
          "delivery_evidence": { "type": "string" },
          "english_semantic": { "type": "string" },
          "french_semantic": { "type": "string" },
          "accessibility_requirement": { "type": "string" },
          "manifest_fields": { "type": "array", "items": { "type": "string" } },
          "integrity_dependency": { "type": "string" },
          "control_totals_requirement": { "type": "string" },
          "source_provenance": { "type": "string" },
          "version_distinction": { "type": "string" },
          "source_authority": { "type": "string" },
          "validation_classes": { "type": "array", "items": { "type": "string" } },
          "acceptance_authority": { "type": "string" },
          "reject_conditions": { "type": "string" },
          "quarantine_conditions": { "type": "string" },
          "partial_success_posture": { "type": "string" },
          "duplicate_posture": { "type": "string" },
          "unknown_record_posture": { "type": "string" },
          "identity_resolution_dependency": { "type": "string" },
          "correction_posture": { "type": "string" },
          "authoritative_state_consequence": { "type": "string" },
          "export_authority": { "type": "string" },
          "recipient": { "type": "string" },
          "recipient_authority_status": { "type": "string" },
          "disclosure_basis_status": { "type": "string" },
          "redaction_requirement": { "type": "string" },
          "receipt_evidence": { "type": "string" },
          "recipient_processing_status": { "type": "string" },
          "acceptance_posture": { "type": "string" },
          "non_authoritative_posture": { "type": "string" },
          "mapping_posture": { "type": "string" },
          "uncertainty_posture": { "type": "string" },
          "coexistence_dependency": { "type": "string" },
          "cutover_dependency": { "type": "string" },
          "resolution_posture": { "type": "string" },
          "unresolved_posture": { "type": "string" },
          "continuity_posture": { "type": "string" },
          "substitution_posture": { "type": "string" },
          "degraded_service_posture": { "type": "string" },
          "return_posture": { "type": "string" },
          "portability_posture": { "type": "string" },
          "deletion_evidence_posture": { "type": "string" },
          "residual_copy_posture": { "type": "string" },
          "exit_posture": { "type": "string" },
          "termination_distinction": { "type": "string" },
          "exit_acceptance": { "type": "string" },
          "reconciliation_owner_status": { "type": "string" },
          "closure_evidence": { "type": "string" },
          "replacement_posture": { "type": "string" },
          "provider_dependency": { "type": "string" },
          "future_test_class": { "type": "string" },
          "authorizes_implementation": { "const": false },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "future_blocking_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "chapter_ref": { "type": "string" },
          "traces_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
