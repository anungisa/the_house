{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contract-requirements.schema.json",
  "title": "REG-802 Contract Requirements, Messages, Errors, Delivery, and Compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_id", "name", "status", "version", "records"],
  "properties": {
    "register_id": { "const": "REG-802" },
    "name": { "type": "string" },
    "status": { "$ref": "common.schema.json#/definitions/registerStatus" },
    "version": { "$ref": "common.schema.json#/definitions/semver" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "statement", "authorizes_implementation", "implementation_status", "validation_status", "chapter_ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^(COMMAND|QUERY|EVENT|WEBHOOK|EXCHANGE|BATCH|FILE|MESSAGE|ERROR|SCHEMA|IDEMP|RETRY|DELIV|REPLAY|RECON|CONTRACT)-V8-[0-9]{3}$" },
          "kind": { "$ref": "common.schema.json#/definitions/requirementKind" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "interaction_type": { "$ref": "common.schema.json#/definitions/interactionType" },
          "institutional_authority": { "$ref": "common.schema.json#/definitions/authorityDomain" },
          "authoritative_source": { "type": "string" },
          "classification": { "$ref": "common.schema.json#/definitions/classification" },
          "sensitivity": { "$ref": "common.schema.json#/definitions/sensitivityLevel" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "result_semantics": { "type": "string" },
          "error_semantics": { "type": "string" },
          "acceptance_semantics": { "type": "string" },
          "completion_distinction": { "type": "string" },
          "staleness_posture": { "type": "string" },
          "source_posture": { "type": "string" },
          "envelope_fields": { "type": "array", "items": { "type": "string" } },
          "delivery_posture": { "$ref": "common.schema.json#/definitions/deliveryPosture" },
          "ordering_requirement": { "$ref": "common.schema.json#/definitions/orderingRequirement" },
          "idempotency_requirement": { "$ref": "common.schema.json#/definitions/idempotencyRequirement" },
          "idempotency_scope": { "type": "string" },
          "deduplication_scope": { "type": "string" },
          "concurrency_precondition": { "type": "string" },
          "replay_posture": { "type": "string" },
          "retry_posture": { "type": "string" },
          "exactly_once_business_invariant": { "type": "string" },
          "conflict_outcome": { "type": "string" },
          "authentication_requirement": { "type": "string" },
          "integrity_requirement": { "type": "string" },
          "reconciliation_dependency": { "type": "string" },
          "canonical_code": { "type": "string" },
          "retryable": { "type": "string", "enum": ["RETRYABLE", "NON_RETRYABLE", "CONDITIONAL"] },
          "user_safe_semantic": { "type": "string" },
          "correlation_requirement": { "type": "string" },
          "logging_constraint": { "type": "string" },
          "privacy_constraint": { "type": "string" },
          "support_boundary": { "type": "string" },
          "accept_reject_quarantine_semantics": { "type": "string" },
          "manifest_and_integrity": { "type": "string" },
          "duplicate_handling": { "type": "string" },
          "compatibility_state": { "$ref": "common.schema.json#/definitions/compatibilityState" },
          "consumer_evidence": { "type": "string" },
          "deprecation_rule": { "type": "string" },
          "evidence_requirement": { "type": "string" },
          "authorizes_implementation": { "const": false },
          "implementation_status": { "$ref": "common.schema.json#/definitions/implementationStatus" },
          "validation_status": { "$ref": "common.schema.json#/definitions/validationStatus" },
          "future_blocking_gate": { "$ref": "common.schema.json#/definitions/futureGateId" },
          "chapter_ref": { "type": "string" },
          "traces_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
